{
  "name": "vibe-field",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env tooling/dev-runner/src/cli.mjs",
    "dev:onboarding": "node --env-file-if-exists=.env tooling/dev-runner/src/cli.mjs --force-onboarding",
    "smoke": "pnpm --filter @vibefield/desktop smoke",
    "smoke:canvas": "pnpm --filter @vibefield/desktop smoke:canvas",
    "smoke:godview": "pnpm --filter @vibefield/desktop smoke:godview",
    "bench:logging-baseline": "node scripts/bench-logging-baseline.mjs",
    "bench:logging-native": "cargo test --release -p field-native logging_reference_benchmark -- --ignored --nocapture",
    "build": "nx run @vibefield/desktop:build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:rust": "cargo test --workspace",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format": "biome format --write . && cargo fmt",
    "icons:generate": "pnpm --filter @vibefield/desktop icons:generate",
    "icons:check": "pnpm --filter @vibefield/desktop icons:check",
    "gen": "pnpm --filter @vibefield/contracts gen:rust",
    "gen:manifests": "nx run-many -t gen:manifest",
    "gen:check": "pnpm gen && git diff --exit-code -- packages/contracts/gen packages/field-native/src/contracts.rs packages/field-native/src/registries.rs",
    "preflight": "node scripts/preflight.mjs",
    "verify": "pnpm preflight && pnpm icons:check && pnpm typecheck && pnpm lint && cargo fmt --check && pnpm lint:rust && pnpm test && pnpm test:rust && pnpm gen:check",
    "commit-draft": "sh scripts/commit-draft.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "nx": "23.1.0"
  },
  "license": "MIT"
}
