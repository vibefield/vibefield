{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit/godview/contracts/fixture.schema.json",
  "title": "GodviewViewFixture",
  "description": "A deterministic fixture for one real monitor view. Synthetic fixtures carry an explicit label. GV-AUDIT05 writes instances; this file is only the contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureId",
    "origin",
    "pins",
    "viewId",
    "lifecycleStates",
    "adapterIds",
    "component"
  ],
  "properties": {
    "fixtureId": { "type": "string", "pattern": "^fix\\.[a-z][a-z0-9.-]*$" },
    "origin": { "enum": ["captured", "synthetic", "golden"] },
    "syntheticLabel": { "type": "string", "minLength": 12 },
    "pins": { "$ref": "provenance.schema.json#/$defs/pins" },
    "viewId": { "$ref": "provenance.schema.json#/$defs/viewId" },
    "lifecycleStates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "provenance.schema.json#/$defs/stateId" }
    },
    "adapterIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "provenance.schema.json#/$defs/adapterId" }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "sha", "path", "symbol"],
      "properties": {
        "repo": { "enum": ["vibefield", "puppeteer"] },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 3 },
        "symbol": { "type": "string", "minLength": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 }
      }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["origin"],
        "properties": { "origin": { "const": "synthetic" } }
      },
      "then": { "required": ["syntheticLabel"] }
    }
  ]
}
