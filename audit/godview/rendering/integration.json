  "holes": [
    {
      "stateId": "state.wait_multiple",
      "reason": "No view reads wait.count. The five views' field lists and a search of packages/views/src at 748d015 find no wait.count read."
    },
    {
      "stateId": "state.working_with_blockers",
      "reason": "bubble-model.ts draws a wait only when appearance is blocked (line 536). detailLine uses the wait only when status is blocked. A working row with a wait paints as working."
    },
    {
      "stateId": "state.activity_starting",
      "reason": "AgentSwarm.tsx reads activity.kind only to keep a terminal clock across kind unknown. It does not paint a distinct branch per activity kind."
    },
    {
      "stateId": "state.activity_responding",
      "reason": "Same as state.activity_starting. No per-kind paint."
    },
    {
      "stateId": "state.activity_reasoning",
      "reason": "Same as state.activity_starting. No per-kind paint."
    },
    {
      "stateId": "state.activity_tool",
      "reason": "Same as state.activity_starting. No per-kind paint."
    },
    {
      "stateId": "state.activity_delegating",
      "reason": "Same as state.activity_starting. No per-kind paint."
    },
    {
      "stateId": "state.activity_compacting",
      "reason": "Same as state.activity_starting. No per-kind paint."
    },
    {
      "stateId": "state.activity_other",
      "reason": "Same as state.activity_starting. No per-kind paint."
    },
    {
      "stateId": "state.failed_retained",
      "reason": "alive is not read by the five views. Retention is VibeField keepsFailure in field-app, outside this Puppeteer view render. Passing the row paints as state.blocked_failure."
    },
    {
      "stateId": "state.dead_hidden",
      "reason": "The row is omitted before the view. The views have no dead-hidden paint. Membership is VibeField useMonitorAgents, not a 748d015 view branch."
    },
    {
      "stateId": "state.terminal_empty",
      "reason": "empty is a swarm body word for a quiet terminal with no opening, not a list status. List paints that row as state.terminal_quiet. Swarm body paint is the WebGPU canvas."
    },
    {
      "stateId": "state.terminal_opening",
      "reason": "opening is swarm-local input, not an AgentView field. MonitorViewHost does not accept it."
    },
    {
      "stateId": "state.attachable",
      "reason": "None of the five views read attachable. It is not in their contract field lists."
    },
    {
      "stateId": "state.reply_streaming",
      "reason": "No view reads reply.final. detailLine uses reply.text and does not branch on final, so streaming and final are not separate paint."
    },
    {
      "stateId": "state.reply_final",
      "reason": "Same as state.reply_streaming. reply.final is not read."
    },
