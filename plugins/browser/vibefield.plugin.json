{
  "activation": [
    "onSurface:vibefield.browser.artifacts",
    "onWidget:vibefield.browser.page"
  ],
  "capabilities": [
    "artifact.publish",
    "workspace.read",
    "shell.dialog",
    "shell.open",
    "surface.attach",
    "surface.browser"
  ],
  "contributes": {
    "surfaces": [
      {
        "id": "vibefield.browser.artifacts",
        "order": 100,
        "slot": "hud.side-panel",
        "title": "Artifacts"
      }
    ],
    "widgets": [
      {
        "category": "Tools",
        "defaultSize": {
          "h": 380,
          "w": 520
        },
        "description": "A live web page on the canvas — navigate it where it sits",
        "groups": {
          "address": [
            "url"
          ],
          "chrome": [
            "showChrome"
          ],
          "title": [
            "title"
          ]
        },
        "interaction": {
          "keyboard": "exclusive",
          "keyboardEscape": "release",
          "movable": true,
          "resizable": true,
          "selectable": true,
          "snap": "target"
        },
        "minSize": {
          "h": 200,
          "w": 280
        },
        "preview": {
          "kind": "color",
          "value": "#1c1f26"
        },
        "props": {
          "showChrome": {
            "default": true,
            "kind": "boolean"
          },
          "title": {
            "default": "",
            "kind": "string"
          },
          "url": {
            "default": "about:blank",
            "kind": "string"
          }
        },
        "provides": [
          "widget"
        ],
        "schemaVersion": 1,
        "sizeMode": "fixed",
        "surface": "dom",
        "title": "Browser",
        "type": "vibefield.browser.page"
      }
    ]
  },
  "engines": {
    "app": ">=0.0.0",
    "contracts": "^0.1.0"
  },
  "entries": {
    "renderer": "./dist/renderer.js"
  },
  "id": "vibefield.browser",
  "manifestVersion": 1,
  "title": "Browser",
  "version": "0.1.0"
}
