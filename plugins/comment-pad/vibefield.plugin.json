{
  "activation": [
    "onObject:vibefield.comment-pad"
  ],
  "capabilities": [],
  "contributes": {
    "objects": [
      {
        "agent": {
          "concurrency": "many",
          "faces": [
            {
              "id": "live",
              "label": "Live",
              "type": "ref"
            },
            {
              "format": "plain",
              "id": "words",
              "label": "Its words",
              "type": "text"
            }
          ],
          "guide": "./assets/agent/guide.md",
          "summary": "A pad of comments, one to a line.",
          "tools": [
            {
              "description": "Read every comment on this pad, one to a line.",
              "input": {
                "additionalProperties": false,
                "properties": {},
                "type": "object"
              },
              "name": "read_text",
              "output": {
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              },
              "readOnly": true
            },
            {
              "description": "Add one comment at the foot of this pad, on a line of its own. The user can undo it.",
              "input": {
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "maxLength": 2000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              },
              "name": "add_comment",
              "output": {
                "properties": {
                  "comments": {
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "comments"
                ],
                "type": "object"
              },
              "readOnly": false
            }
          ]
        },
        "binding": {
          "kind": "commentPad"
        },
        "description": "A pad of comments: tap it and write — each line a comment, kept with the board, undone a session at a time",
        "groups": {
          "ink": [
            "text",
            "seeds"
          ]
        },
        "interaction": {
          "movable": true,
          "resizable": false,
          "selectable": true,
          "snap": "both"
        },
        "props": {
          "accent": {
            "default": "indigo",
            "kind": "enum",
            "options": [
              "indigo",
              "pink",
              "green",
              "amber",
              "cyan",
              "violet",
              "red",
              "blue"
            ]
          },
          "pen": {
            "default": "ball",
            "kind": "enum",
            "options": [
              "felt",
              "ball",
              "fountain",
              "red"
            ]
          },
          "seed": {
            "default": 0,
            "kind": "number"
          },
          "seeds": {
            "default": "",
            "kind": "string",
            "maxLength": 200000
          },
          "text": {
            "default": "",
            "kind": "string",
            "maxLength": 20000
          }
        },
        "provides": [
          "vibefield.comment-pad",
          "desk.object",
          "desk.containable"
        ],
        "schemaVersion": 1,
        "size": {
          "h": 280,
          "w": 220
        },
        "title": "Comment pad",
        "type": "vibefield.comment-pad"
      }
    ]
  },
  "description": "A pad of comments lying on the desk — tap it and write in the desk's hand; its lines are the document's, undoable, shared with every peer",
  "engines": {
    "app": ">=0.0.0",
    "contracts": "^0.1.0"
  },
  "entries": {
    "renderer": "./dist/renderer.js"
  },
  "id": "vibefield.comment-pad",
  "manifestVersion": 1,
  "title": "Comment pad",
  "version": "0.1.0"
}
