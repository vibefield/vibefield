{
  "name": "@vibefield/plugin-comment-pad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VibeField's first own object kind (DK-8, DK-D14): the comment pad — a durable pad of comments lying on the desk, written in the desk's hand through the kit and the host's text raster, through @vibefield/plugin-sdk/desk alone.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "plugin-build",
    "gen:manifest": "tsx scripts/emit-manifest.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibefield/contracts": "workspace:*",
    "@vibefield/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vibefield/plugin-build": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
