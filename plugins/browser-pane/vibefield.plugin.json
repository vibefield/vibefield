{
  "activation": [
    "onObject:vibefield.browser-pane"
  ],
  "capabilities": [
    "surface.attach",
    "surface.browser"
  ],
  "contributes": {
    "objects": [
      {
        "agent": {
          "concurrency": "many",
          "faces": [
            {
              "label": "Live",
              "type": "ref"
            },
            {
              "label": "Picture",
              "type": "image"
            }
          ],
          "room": "pages",
          "summary": "A web page on the desk. Work it with the browser tools; you can work only the pages you opened with them, not the user's.",
          "tools": []
        },
        "binding": {
          "kind": "browserPane"
        },
        "description": "A pane of glass cut to its page: resize it and its page re-lays out; switch its device and it is re-cut to that screen's size",
        "groups": {
          "page": [
            "url",
            "runAddress"
          ]
        },
        "interaction": {
          "movable": true,
          "resizable": true,
          "selectable": true,
          "snap": "both"
        },
        "minSize": {
          "h": 146.35,
          "w": 165.39
        },
        "props": {
          "agentRun": {
            "default": "",
            "kind": "string",
            "maxLength": 128
          },
          "device": {
            "default": "laptop",
            "kind": "enum",
            "options": [
              "laptop",
              "desktop",
              "tablet",
              "phone",
              "custom"
            ]
          },
          "deviceScaleFactor": {
            "default": 0,
            "kind": "number",
            "max": 8,
            "min": 0
          },
          "finish": {
            "default": "low-iron",
            "kind": "enum",
            "options": [
              "low-iron",
              "float",
              "smoke",
              "bronze"
            ]
          },
          "inputMode": {
            "default": "device",
            "kind": "enum",
            "options": [
              "device",
              "desktop",
              "desktop-touch",
              "mobile",
              "mobile-pointer"
            ]
          },
          "muted": {
            "default": false,
            "kind": "boolean"
          },
          "navigatorPlatform": {
            "default": "",
            "kind": "string",
            "maxLength": 32
          },
          "runAddress": {
            "default": "",
            "kind": "string",
            "maxLength": 2048
          },
          "scheme": {
            "default": "desk",
            "kind": "enum",
            "options": [
              "desk",
              "light",
              "dark"
            ]
          },
          "url": {
            "default": "https://lumen.example/",
            "kind": "string",
            "maxLength": 2048
          },
          "userAgent": {
            "default": "",
            "kind": "string",
            "maxLength": 512
          },
          "userAgentMode": {
            "default": "device",
            "kind": "enum",
            "options": [
              "device",
              "browser",
              "custom"
            ]
          }
        },
        "provides": [
          "vibefield.browser-pane",
          "desk.object"
        ],
        "schemaVersion": 1,
        "size": {
          "h": 461.94,
          "w": 698.16
        },
        "sticker": {
          "art": "./assets/sticker.svg",
          "name": "url",
          "radius": 6
        },
        "title": "Browser",
        "tray": {
          "category": "portals",
          "hang": {
            "accessory": "shelf",
            "h": 138.58,
            "pegs": [
              [
                -2,
                0.5
              ],
              [
                2,
                0.5
              ]
            ],
            "w": 209.45
          },
          "label": "Browser",
          "local": true,
          "order": 0
        },
        "type": "vibefield.browser-pane"
      }
    ]
  },
  "description": "Live web pages on your desk: browse them, sign in, and choose the device they're shown at. No account needed.",
  "engines": {
    "app": ">=0.0.0",
    "contracts": "^0.1.0"
  },
  "entries": {
    "renderer": "./dist/renderer.js"
  },
  "id": "vibefield.browser-pane",
  "manifestVersion": 1,
  "title": "Browser",
  "version": "0.1.0"
}
