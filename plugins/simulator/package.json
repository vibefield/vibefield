{
  "name": "@vibefield/plugin-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PORTALS' iOS Simulator (PT-S1): a phone lying face up on the desk at its true size — any of the 42 iPhones Xcode's Simulator knows — its screen a Simulator's, view-only until PT-S4's touch lands; a plugin kind through @vibefield/plugin-sdk/desk alone.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "plugin-build",
    "gen:manifest": "tsx scripts/emit-manifest.ts",
    "gen:catalog": "tsx scripts/make-catalog.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibefield/contracts": "workspace:*",
    "@vibefield/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@types/node": "catalog:",
    "@vibefield/plugin-build": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
