#!/bin/sh
# 1) dev-local is the local-only design-docs branch — it must never reach a remote.
# 2) every push runs the full verify gate (SKIP_VERIFY=1 git push to bypass).
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/heads/dev-local)
      echo "refused: 'dev-local' is a local-only branch (draft design docs). It is never pushed." >&2
      exit 1
      ;;
  esac
done

if [ -z "$SKIP_VERIFY" ]; then
  echo "pre-push: running 'pnpm verify' (SKIP_VERIFY=1 to bypass)..." >&2
  (
    # Git exports this worktree's repository context to hooks. Verification
    # also reads sibling repositories: let their own cwd select their Git
    # directory instead of inheriting this worktree's HEAD and index.
    git_local_env=$(git rev-parse --local-env-vars) || exit 1
    for git_env_name in $git_local_env; do
      unset "$git_env_name"
    done
    pnpm verify
  ) || exit 1
fi
exit 0
