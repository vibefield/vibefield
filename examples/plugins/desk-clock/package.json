{
  "name": "@vibefield/plugin-example-desk-clock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "THE PARITY WITNESS (DK-6): ICE's analogue desk clock as a VibeField plugin — its own WGSL, pass, wake, tray entry, menu act and held tools — through @vibefield/plugin-sdk/desk alone, drawn by the product beside the desk's six built-ins.",
