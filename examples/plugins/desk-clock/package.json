    "gen:manifest": "tsx scripts/emit-manifest.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibefield/contracts": "workspace:*",
    "@vibefield/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vibefield/plugin-build": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
