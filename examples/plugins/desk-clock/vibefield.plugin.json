        "groups": {},
        "interaction": {
          "movable": true,
          "resizable": false,
          "selectable": true,
          "snap": "both"
        },
        "props": {
          "ring24": {
            "default": false,
            "kind": "boolean"
          },
          "seconds": {
            "default": true,
            "kind": "boolean"
          },
          "style": {
            "default": "classic",
            "kind": "enum",
            "options": [
              "classic",
              "station",
              "graphite"
            ]
          },
          "zone": {
            "default": "local",
            "kind": "string"
          }
        },
