                "additionalProperties": false,
                "properties": {},
                "type": "object"
              },
              "name": "read_settings",
              "readOnly": true
            },
            {
              "description": "Show or hide this clock's seconds hand. The user can undo it.",
              "input": {
                "additionalProperties": false,
                "properties": {
                  "on": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "on"
                ],
                "type": "object"
              },
              "name": "set_seconds",
              "readOnly": false
            }
          ]
        },
        "binding": {
          "kind": "clock"
        },
