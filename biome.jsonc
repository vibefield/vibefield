{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // vibefield.plugin.json: GENERATED canonical artifacts (plugin spec §5.2) —
    // byte-stable key-sorted JSON whose only formatter is the plugin-build
    // emitter; biome's array-collapsing would fight the freshness tests.
    //
    // create-plugin/template: the scaffolder's source files, carrying `{{token}}`
    // placeholders in identifier positions — deliberately not parseable until the
    // substitution pass has run. What biome DOES check is the output: every
    // scaffold lands as workspace source, and `test/output-conformance.test.ts`
    // asserts the substituted tree parses and carries no leftover token.
    //
    // `fixtures/terminal-perf` is generated the same way `packages/contracts/gen`
    // is: the TRF1 corpus and its manifest are written by
    // `pnpm perf:terminal:capture` from a real cell's output, so formatting them
    // by hand would be undone by the next capture and formatting them IN the
    // capture would be teaching a recorder about biome. The `.trf1` files are
    // binary; the manifest is `JSON.stringify(…, null, 2)`.
    //
    // `truffle-rfc025` (RFC 025 window): biome FOLLOWS symlinks, and
    // apps/ios/VibeFieldKit/.window/truffle — the SwiftPM identity link the
    // window needs — points at a whole other repository. Without this line
    // `biome check .` walks that checkout and reports ITS lint (readline
    // imports, napi `any`s): a red gate, and an offer to rewrite a tree this
    // repo may only read. The pattern names the RESOLVED directory because that
    // is what biome matches once it has followed the link — a `!apps/ios/…`
    // pattern on the link's own path matches nothing, and apps/ios/biome.jsonc,
    // which turns biome off for that subtree, does not reach past a symlink
    // either. Both were tried. The cargo and npm halves of that window closed on
    // 2026-09-16 (UA-P-X) and this line stayed, because the SwiftPM half could
    // not: ghosttea pins truffle exactly at 0.7.12, so the kit can move to
    // neither 0.7.14 nor back. Goes when the link does.
    //
    "includes": [
      "**",
      "!packages/contracts/gen",
      "!fixtures/terminal-perf",
      "!**/vibefield.plugin.json",
      "!tooling/create-plugin/template",
      "!**/truffle-rfc025",
      // glyphs/data.ts is GENERATED by tooling/glyphs/build.mjs (DESIGN.md §13); its
      // freshness test compares bytes, so only the generator formats it.
      "!packages/design-kit/src/glyphs/data.ts",
      // design-kit/assets/ is GENERATED art (tooling/fieldmarks/generate.py and
      // tooling/face-stickers/generate.py, DESIGN.md §11): the generators own its
      // bytes. Its sprite sheets are containers of <symbol>s that a <use> names, so
      // the sheet's root <svg> is never an image that needs a <title> of its own.
      "!packages/design-kit/assets"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // bracket access on parsed/passthrough JSON records is idiomatic here
        "useLiteralKeys": "off"
      },
      "style": {
        // under exactOptionalPropertyTypes + noUncheckedIndexedAccess, `!` is a
        // deliberate, visible escape hatch (mostly fixtures/tests)
        "noNonNullAssertion": "off"
      },
      "a11y": {
        // canvas widgets: ICE's input contract owns focus/interaction semantics
        "noAutofocus": "off",
        "noStaticElementInteractions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      // Packaging icon sources are build inputs, never inline/document content.
      // Keep both imported vectors and Icon Composer's package serialization
      // exact; DOM formatting/accessibility rules do not apply to either.
      "includes": [
        "apps/desktop/packaging/icons/*-master.svg",
        "apps/desktop/packaging/icons/*.icon/**"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      // LOG-L3/LOG-L4: runtime code must use its injected system/plugin logger.
      // Only tests and explicit smoke/development protocols remain exempt.
      "includes": [
        "packages/*/src/**/*.{ts,tsx,js,mjs,cjs}",
        "!packages/electron-shell/src/testing/smoke.ts",
        "!packages/field-app/src/spike/**",
        "!packages/field-app/src/development-console.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      // Tailwind v4 CSS-first at-rules (@custom-variant, @source, @theme, …)
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
