{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // vibefield.plugin.json: GENERATED canonical artifacts (plugin spec §5.2) —
    // byte-stable key-sorted JSON whose only formatter is the plugin-build
    // emitter; biome's array-collapsing would fight the freshness tests.
    "includes": ["**", "!packages/contracts/gen", "!**/vibefield.plugin.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // bracket access on parsed/passthrough JSON records is idiomatic here
        "useLiteralKeys": "off"
      },
      "style": {
        // under exactOptionalPropertyTypes + noUncheckedIndexedAccess, `!` is a
        // deliberate, visible escape hatch (mostly fixtures/tests)
        "noNonNullAssertion": "off"
      },
      "a11y": {
        // canvas widgets: ICE's input contract owns focus/interaction semantics
        "noAutofocus": "off",
        "noStaticElementInteractions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      // LOG-L3: first-party runtime code must use the injected logger. Tests,
      // smoke/dev protocols, and plugin-origin adapters have separate evidence
      // contracts and remain outside this rule's scope.
      "includes": [
        "packages/*/src/**/*.{ts,tsx,js,mjs,cjs}",
        "!packages/electron-shell/src/testing/smoke.ts",
        "!packages/field-app/src/spike/**",
        "!packages/field-app/src/development-console.ts",
        "!packages/field-app/src/plugin-host/renderer-harness.ts",
        "!packages/fieldd/src/plugin-service-console.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      // Tailwind v4 CSS-first at-rules (@custom-variant, @source, @theme, …)
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
