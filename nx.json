{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.nvmrc",
      {
        "runtime": "node --version"
      },
      {
        "runtime": "pnpm --version"
      }
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.{js,jsx,mjs,cjs,ts,tsx}",
      "!{projectRoot}/**/*.spec.{js,jsx,mjs,cjs,ts,tsx}",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/coverage/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        {
          "env": "NODE_ENV"
        },
        {
          "env": "VITE_SPIKE"
        }
      ]
    },
    "build:renderer": {
      "cache": true,
      "inputs": [
        "production",
        "^production",
        {
          "env": "NODE_ENV"
        },
        {
          "env": "VITE_SPIKE"
        }
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "gen:manifest": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "continuous": true
    }
  },
  "analytics": false
}
