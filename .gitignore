# local-only design docs — tracked on the dev-local branch via scripts/commit-draft.sh, never on main
/draft/

# deps & build output
node_modules/
dist/
build/
target/
/target
coverage/
*.tsbuildinfo
__pycache__/
.turbo/
.nx/
.vibefield/
# RD-2: the dev overlay's pnpmfile — generated by `pnpm siblings use NAME`, removed by `use --none`; pnpm loads a root
# .pnpmfile.cjs by default, so a committed one would change every install (thinking-release-deps.md §3)
/.pnpmfile.cjs
# RD-3: the dev overlay's cargo half — generated by `pnpm siblings use NAME` for a released cargo plane, removed by `use --none`
/.cargo/config.toml
# a plugin's stills as `plugin-playground --still` writes them (DK-11) — for eyes, never a source
.vibefield-still/
# what `vibefield-plugin try` leaves in the plugin it tried (DK-10): its log and its stills — the
# landing gate tries the example clock (DK-18), so a checkout's example gains them
.vibefield-try/

# env & secrets (the committed template is the one exception)
.env
.env.*
!.env.example

# editors & OS
.idea/
.vscode/
.DS_Store

# logs
*.log
logs/
.pnpm-store/

# packaged artifacts (WP4): electron-builder's output. Hundreds of MB per build,
# and a release artifact is produced by the release workflow from a tag — never
# committed. `apps/desktop/build/` (the deterministic stage) is already covered
# by the `build/` rule above.
release/

# `.vfplugin` artifacts (plugin spec §5.3.1): `vibefield-plugin pack` writes one
# beside the plugin by default. It is a RELEASE artifact whose sha256 an index
# pins — produced from a tag, attached to a release, never committed.
*.vfplugin

# Xcode / SwiftPM (apps/ios) — user state and local build products only;
# project.pbxproj and xcshareddata (schemes) are tracked.
xcuserdata/
*.xcresult
.build/


# TP-S0a — the byte traces the corpus is replayed FROM. Regenerated by the
# capture (`pnpm --filter @vibefield/terminal-perf capture`); the `.trf1`
# fixtures beside them are the committed artifact.
fixtures/terminal-perf/.sources/

# 2026-10-14: private local audit; removed from history before the first push (RL1(c)).
/work/godview-audit-2026-09-25/
