# local-only design docs — tracked on the dev-local branch via scripts/commit-draft.sh, never on main
/draft/

# deps & build output
node_modules/
dist/
build/
target/
coverage/
*.tsbuildinfo
.turbo/

# env & secrets (the committed template is the one exception)
.env
.env.*
!.env.example

# editors & OS
.idea/
.vscode/
.DS_Store

# logs
*.log
logs/
.pnpm-store/

# packaged artifacts (WP4): electron-builder's output. Hundreds of MB per build,
# and a release artifact is produced by the release workflow from a tag — never
# committed. `apps/desktop/build/` (the deterministic stage) is already covered
# by the `build/` rule above.
release/
