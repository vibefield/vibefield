  } else if(K_rise.x > 0.5f) {
  const auto n = max(floor(K_palC.x + 0.5f), 1.0f);
  const auto s0 = c.pn * K_rise.y - K_rise.z;
  const auto cells = max(floor(K_rise3.y + 0.5f), 1.0f);
  const auto q = float2(up * cells, s0);
  const auto per = float2(cells, n);
  auto qw = q;
  if(K_rise3.z > 0.0f) {
  qw = q + K_rise3.z * float2(pnoise2(ctx, q, per, 81u), pnoise2(ctx, q + float2(5.2f, 1.3f), per, 91u));
  }
  const auto crowd = smoothstep(0.15f, 0.5f, 2.0f * c.fp * K_rise.y);
  const auto s = s0 + K_rise3.x * pfbm(ctx, qw, per, 71u) * (1.0f - crowd);
  const auto k = floor(s);
  const auto f = smoothstep(0.0f, 1.0f, s - k);
  const auto x0 = fieldX(ctx, up, inside, k / n, 0u);
  const auto la = fieldLab(ctx, x0, rp, fws, mk);
  const auto lb = fieldLab(ctx, x0 + 1.0f / n, rp, fws, mk);
  lab = mix(la, lb, f);
