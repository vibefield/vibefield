  const auto on = step(h1(ctx, wgsl::u32(jm) * 7919u + s0 * 104729u), K_accent.x);
  const auto ci = min(wgsl::i32(h1(ctx, wgsl::u32(jm) * 15485863u + 17u + s0) * 4.0f), 3);
  col = mix(col, clamp(K_acc[ci].rgb * mk, float3(0.0f), float3(1.0f)), clamp(cov * on * K_accent.z * K_acc[ci].a, 0.0f, 1.0f));
  }
  col = col * c.lit;
  col = mix(col, K_throatC.rgb, c.fog * K_throatC.a);
  if(K_wellRing.w > - 7.99f) {
  col = mix(K_throatC.rgb, col, smoothstep(K_wellRing.w - c.fp, K_wellRing.w + c.fp, c.pn));
  }
  if(K_wellRing.x > 0.0f) {
  const auto rz = (c.pn - K_wellRing.y) / max(K_wellRing.z, 1e-3f);
  const auto ring = K_wellRing.x * exp(- rz * rz) * (1.0f - smoothstep(0.3f, 1.2f, c.fp / max(K_wellRing.z, 1e-3f)));
  col = 1.0f - (1.0f - col) * (1.0f - clamp(K_ringC.rgb * mk * ring, float3(0.0f), float3(1.0f)));
  }
  const auto gp = p - K_glowAt.xy;
  const auto rr = dot(gp, gp) / max(K_glow.y * K_glow.y, 1e-6f);
  const auto gl = K_glow.x * exp(- rr) + K_glow.z * exp(- rr * 25.0f);
  col = 1.0f - (1.0f - col) * (1.0f - clamp(K_glowC.rgb * gl, float3(0.0f), float3(1.0f)));
  const auto dim = K_lobe.y;
  col = mix(col, wgsl::select(float3(1.0f), float3(0.0f), dim > 0.0f), abs(dim) * inside);
  return clamp(col, float3(0.0f), float3(1.0f));
}
template <typename Ctx> float wellMarchHi(thread Ctx& ctx, float2 p) {
const auto w = p * K_camR.w + float2(K_camU.w, K_camF.w);
  const auto d = normalize(K_camF.xyz + w.x * K_camR.xyz + w.y * K_camU.xyz);
  const auto o = K_camPos.xyz;
  const auto dz = min(d.z, - 1e-5f);
  auto lo = 0.0f;
  auto hi = 0.0f;
  auto found = 0.0f;
  auto prev = 0.0f;
  auto D = 2e-3f;
  for(auto i = 0; i < 34; i++) {
  const auto xy = o.xy + ((o.z + D) / - dz) * d.xy;
  const auto g = length(float2(xy.x, xy.y * wellSquash(ctx, D))) - wellR(ctx, D);
  const auto crossed = step(0.0f, g) * (1.0f - found);
  lo = mix(lo, prev, crossed);
  hi = mix(hi, D, crossed);
  found = max(found, crossed);
  prev = D;
  D = D * 1.55f;
  }
  for(auto i = 0; i < 12; i++) {
  const auto mid = 0.5f * (lo + hi);
  const auto xy = o.xy + ((o.z + mid) / - dz) * d.xy;
  const auto above = length(float2(xy.x, xy.y * wellSquash(ctx, mid))) - wellR(ctx, mid) > 0.0f;
  hi = wgsl::select(hi, mid, above);
  lo = wgsl::select(mid, lo, above);
  }
  return wgsl::select(- 1.0f, hi, found > 0.5f);
}
template <typename Ctx> Coords wellCoordsAt(thread Ctx& ctx, float2 p, float hiC) {
const auto w = p * K_camR.w + float2(K_camU.w, K_camF.w);
  const auto d = normalize(K_camF.xyz + w.x * K_camR.xyz + w.y * K_camU.xyz);
  const auto o = K_camPos.xyz;
  const auto dz = min(d.z, - 1e-5f);
  const auto found = wgsl::select(0.0f, 1.0f, hiC >= 0.0f);
  const auto hi = max(hiC, 0.0f);
  const auto hit = found > 0.5f;
  const auto Dh = wgsl::select(1e7f, hi, hit);
  const auto pos = o + ((o.z + Dh) / - dz) * d;
  const auto twist = K_well.w * log(1.0f + Dh);
  const auto sy = pos.y * wellSquash(ctx, Dh);
  const auto ang = atan2(sy, pos.x) + twist + (*ctx.dyn).flow.y;
  const auto ang2 = atan2(- sy, - pos.x) + PI + twist + (*ctx.dyn).flow.y;
  const auto pn = log(max(wellR(ctx, Dh), 1e-7f));
  const auto rho = max(length(pos.xy), 1e-6f);
  const auto slope = K_well.z * K_well.x * pow(max(Dh, 1e-5f), - K_well.z - 1.0f);
  const auto n = normalize(float3(- pos.xy / rho, slope));
  const auto la = K_wellLook.z;
  const auto L = normalize(float3(cos(la) * 0.7f, sin(la) * 0.7f, 0.72f));
  const auto lit = mix(1.0f, 0.5f + 0.75f * max(dot(n, L), 0.0f), K_wellLook.y);
  const auto fog = wgsl::select(1.0f, 1.0f - exp(- K_wellLook.x * log(1.0f + Dh)), hit);
  const auto fa1 = fwidth(ang);
  const auto fa2 = fwidth(ang2);
  const auto de = 1e-3f * hi;
  const auto xh = o.xy + ((o.z + hi) / - dz) * d.xy;
  const auto xm = o.xy + ((o.z + hi - de) / - dz) * d.xy;
  const auto gh = length(float2(xh.x, xh.y * wellSquash(ctx, hi))) - wellR(ctx, hi);
  const auto gm = length(float2(xm.x, xm.y * wellSquash(ctx, hi - de))) - wellR(ctx, hi - de);
  const auto Df = wgsl::select(1e7f, hi - gh * de / max(gh - gm, 1e-20f), hit);
  const auto pf = o + ((o.z + Df) / - dz) * d;
  const auto tf = K_well.w * log(1.0f + Df);
  const auto sf = pf.y * wellSquash(ctx, Df);
  const auto af = atan2(sf, pf.x) + tf;
  const auto af2 = atan2(- sf, - pf.x) + PI + tf;
  const auto ga = wgsl::select(float2(dfdx(af2), dfdy(af2)), float2(dfdx(af), dfdy(af)), fwidth(af) <= fwidth(af2));
  const auto pnf = log(max(wellR(ctx, Df), 1e-7f));
  return Coords{ang, pn, min(fa1, fa2), fwidth(pn), fog, lit, ga, float2(dfdx(pnf), dfdy(pnf))};
}
template <typename Ctx> float2 gasOctave(thread Ctx& ctx, uint o, float N) {
auto f = 1.0f;
  for(auto i = 0u; i < o; i++) {
  f *= 2.31f;
  }
  const auto ni = max(rint(N * f), 1.0f);
  return float2(ni, max(rint(0.314f * ni), 1.0f));
}
template <typename Ctx> void gasInit(thread Ctx& ctx, uint3 gid) {
const auto i = gid.x;
  const auto N = max((*ctx.dyn).stripA.x, 4.0f);
  const auto seed = wgsl::u32(K_stripC.w + 0.5f) * 7919u;
  if(i < GAS_OCT_TOTAL) {
  auto o = 0u;
  for(auto k = 1u; k < GAS_OCTAVES; k++) {
  if(i >= GAS_OFF[k]) {
  o = k;
  }
  }
  const auto s = float(i - GAS_OFF[o]) / float(GAS_M[o]);
  const auto nc = gasOctave(ctx, o, N);
  const auto pn = pnoiseD(ctx, s * nc.y, nc.y, seed + 11u * o + 1u);
  const auto ph = K_stripB.w * 10.0f * pn.x;
  const auto v = sin(PI * s * nc.x + ph);
  ctx.gasOctW[i] = wgsl::pack2x16float(float2(v * v, abs(K_stripB.w * 10.0f * pn.y * nc.y) / PI));
  if(o == 0u) {
  ctx.gasNoiseW[GAS_PHASE_AT + i] = ph;
  }
  }
  if(i <= GAS_PAL) {
  const auto c = palLab(ctx, float(i) / float(GAS_PAL));
  ctx.gasNoiseW[GAS_PAL_AT + 3u * i] = c.x;
  ctx.gasNoiseW[GAS_PAL_AT + 3u * i + 1u] = c.y;
  ctx.gasNoiseW[GAS_PAL_AT + 3u * i + 2u] = c.z;
  }
  if(i < GAS_STRIPS) {
  const auto ha = i * 2654435761u + seed;
  const auto h = i * 2246822519u + seed;
  ctx.gasStripW[2u * i] = float4(h1(ctx, ha ^ 0x5BD1u), h1(ctx, ha ^ 0x68E3u), h1(ctx, h ^ 0x7F4Bu), h1(ctx, h ^ 0xA341u));
  ctx.gasStripW[2u * i + 1u] = float4(h1(ctx, h ^ 0x27D4u), h1(ctx, h ^ 0x1656u), h1(ctx, h ^ 0xB5E3u), h1(ctx, h));
  }
  if(i < GAS_CUTS) {
  const auto hk = i * 2654435761u + seed;
  ctx.gasCutW[i] = float4(h1(ctx, hk ^ 0x9E37u), h1(ctx, hk ^ 0x85EBu), h1(ctx, hk ^ 0xC2B2u), 0.0f);
  }
  if(i < GAS_WOB_X * GAS_WOB_Y) {
  ctx.gasNoiseW[i] = h2(ctx, int2(wgsl::i32(i % GAS_WOB_X), wgsl::i32(i / GAS_WOB_X)), seed + 3u);
  }
  if(i < 4u * GAS_WOB_X * GAS_WOB_Y) {
  const auto w = 2u * GAS_WOB_X;
  ctx.gasNoiseW[GAS_WOB_X * GAS_WOB_Y + i] = h2(ctx, int2(wgsl::i32(i % w), wgsl::i32(i / w)), seed + 5u);
  }
}
template <typename Ctx> float2 gasAt(thread Ctx& ctx, uint o, float s) {
const auto M = GAS_M[o];
  const auto t = fract(s) * float(M);
  const auto j0 = min(wgsl::u32(t), M - 1u);
  const auto j1 = wgsl::select(j0 + 1u, 0u, j0 + 1u >= M);
  return mix(wgsl::unpack2x16float(ctx.gasOct[GAS_OFF[o] + j0]), wgsl::unpack2x16float(ctx.gasOct[GAS_OFF[o] + j1]), t - float(j0));
}
template <typename Ctx> float gasPhase(thread Ctx& ctx, float s) {
const auto M = GAS_M[0];
  const auto t = fract(s) * float(M);
  const auto j0 = min(wgsl::u32(t), M - 1u);
  const auto j1 = wgsl::select(j0 + 1u, 0u, j0 + 1u >= M);
  return mix(ctx.gasNoise[GAS_PHASE_AT + j0], ctx.gasNoise[GAS_PHASE_AT + j1], t - float(j0));
}
template <typename Ctx> float3 palLabT(thread Ctx& ctx, float x) {
const auto t = fract(x) * float(GAS_PAL);
  const auto j = min(wgsl::u32(t), GAS_PAL - 1u);
  const auto a = float3(ctx.gasNoise[GAS_PAL_AT + 3u * j], ctx.gasNoise[GAS_PAL_AT + 3u * j + 1u], ctx.gasNoise[GAS_PAL_AT + 3u * j + 2u]);
  const auto b = float3(ctx.gasNoise[GAS_PAL_AT + 3u * j + 3u], ctx.gasNoise[GAS_PAL_AT + 3u * j + 4u], ctx.gasNoise[GAS_PAL_AT + 3u * j + 5u]);
  return mix(a, b, t - float(j));
}
template <typename Ctx> float pnoise2T(thread Ctx& ctx, float2 p, float2 period, uint at, uint w) {
const auto fl = floor(p);
  const auto f = p - fl;
  const auto s = f * f * (3.0f - 2.0f * f);
  const auto pr = max(period, float2(1.0f));
  const auto i0 = fl - pr * floor(fl / pr);
  const auto i1 = (i0 + 1.0f) - pr * floor((i0 + 1.0f) / pr);
  const auto a = ctx.gasNoise[at + wgsl::u32(i0.y) * w + wgsl::u32(i0.x)];
  const auto b = ctx.gasNoise[at + wgsl::u32(i0.y) * w + wgsl::u32(i1.x)];
  const auto c = ctx.gasNoise[at + wgsl::u32(i1.y) * w + wgsl::u32(i0.x)];
  const auto d = ctx.gasNoise[at + wgsl::u32(i1.y) * w + wgsl::u32(i1.x)];
  return mix(mix(a, b, s.x), mix(c, d, s.x), s.y) * 2.0f - 1.0f;
}
template <typename Ctx> RingLight ringLightT(thread Ctx& ctx, float s, float fs, float N) {
const auto x = N * s;
  const auto fx = N * fs;
  auto acc = 0.0f;
  auto tot = 0.0f;
  auto amp = 1.0f;
  auto f = 1.0f;
  auto xw = x;
  auto fxw = fx;
  for(auto i = 0u; i < 7u; i++) {
  if(float(i) + 0.5f >= K_stripB.x) {
  break;
  }
  const auto ni = max(rint(N * f), 1.0f);
  const auto e = gasAt(ctx, i, s);
  const auto lf = fs * (ni + e.y);
  acc += amp * mix(e.x, 0.5f, smoothstep(0.2f, 0.5f, lf));
  tot += amp;
  fxw = wgsl::select(fxw, lf, i == 0u);
  amp *= 0.45f;
  f *= 2.31f;
  }
  xw = x + gasPhase(ctx, s) / PI;
  auto I = pow(clamp(acc / max(tot, 1e-4f), 0.0f, 1.0f), K_stripB.y);
  if(K_stripD.y > 0.0f) {
  const auto g = 0.25f * x;
  const auto kg = floor(g);
  const auto per = 0.25f * N;
  const auto cutH = ctx.gasCut[wgsl::u32(kg - per * floor(kg / per))];
  const auto on = step(cutH.x, K_stripD.y);
  const auto og = 4.0f * (0.3f + 0.4f * cutH.y);
  const auto wg = 0.4f + 1.2f * cutH.z;
  const auto cut = on * pulse1(ctx, 4.0f * (g - kg) - og, fx, wg);
  I = I * mix(1.0f - 0.94f * cut, 1.0f - 0.94f * 0.25f * K_stripD.y, smoothstep(1.0f, 3.0f, fx));
  }
  return RingLight{I, xw, fxw};
}
template <typename Ctx> float runWaveT(thread Ctx& ctx, float k, float up, float g) {
const auto hs = ctx.gasStrip[2u * wgsl::u32(k)];
  const auto pace = 1.0f + (*ctx.dyn).runB.z * (2.0f * hs.z - 1.0f);
  const auto ph = fract(rint((*ctx.dyn).runB.y * pace) * (*ctx.dyn).runB.x) - hs.w;
  const auto w0 = sin(TAU * (K_runA.y * up - ph));
  const auto w1 = sin(TAU * (K_runA.z * g - ph));
  return mix(w0, w1, K_runA.w);
}
template <typename Ctx> Rings ringsT(thread Ctx& ctx, Coords c, float up) {
