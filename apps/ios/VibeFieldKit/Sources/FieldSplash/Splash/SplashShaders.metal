  const auto k = seed * 2654435761u;
  const auto a = h1(ctx, wgsl::u32(ia) ^ k);
  const auto b = h1(ctx, wgsl::u32(ib) ^ k);
  return mix(a, b, w) * 2.0f - 1.0f;
