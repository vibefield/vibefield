  const auto still = smoothstep(0.3f, 0.8f, c.fp * K_rise.y);
  if(still > 0.0f) {
  lab = mix(lab, fieldLab(ctx, fieldX(ctx, up, inside, 0.0f, 0u), rp, fws, mk), still);
  }
  } else {
  lab = fieldLab(ctx, fieldX(ctx, up, inside, 0.0f, 0u), rp, fws, mk);
  }
  if(K_stripD.w < 0.5f) {
  lab = float3(lab.x, lab.yz * K_palC.y);
  col = oklabToSrgb(ctx, lab);
  }
  const auto N = K_ground.y;
  const auto fw = max(c.fa * N / TAU * (*ctx.dyn).flow.z, 1e-4f);
  const auto duty = K_ground.z;
  const auto lc = mix(stripe(ctx, c.ang * N / TAU + 0.5f * duty, fw, duty), duty, smoothstep(0.3f, 0.8f, fw));
  auto amt = K_ground.w;
  if((*ctx.dyn).pulse.x > 0.0f) {
