  }
  auto lineCol = K_lineInk.rgb;
  if(K_lineT.x > 0.0f) {
  const auto tl = float3(clamp(lab.x + K_lineT.y, 0.0f, 1.0f), lab.yz * (1.0f + 0.8f * abs(K_lineT.y)));
  lineCol = mix(lineCol, oklabToSrgb(ctx, tl), K_lineT.x);
  }
  col = mix(col, lineCol, clamp(amt * lc, 0.0f, 1.0f));
  const auto A = (*ctx.dyn).flow.w;
  if(A > 0.5f) {
  const auto sa = c.ang * A / TAU;
  const auto j = rint(sa);
  const auto fwa = max(c.fa * A / TAU * (*ctx.dyn).flow.z, 1e-5f);
  const auto jm = j - A * floor(j / A);
  const auto s0 = wgsl::u32(K_accent.w + 0.5f);
