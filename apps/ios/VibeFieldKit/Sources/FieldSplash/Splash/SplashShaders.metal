template <typename Ctx> float4 vs(thread Ctx& ctx, uint i) {
const auto p = float2(float((i << 1u) & 2u), float(i & 2u));
  return float4(p * 2.0f - 1.0f, 0.0f, 1.0f);
}
template <typename Ctx> uint pcg(thread Ctx& ctx, uint v) {
const auto s = v * 747796405u + 2891336453u;
  const auto w = ((s >>((s >> 28u) + 4u)) ^ s) * 277803737u;
  return(w >> 22u) ^ w;
}
template <typename Ctx> float h1(thread Ctx& ctx, uint n) {
return float(pcg(ctx, n)) * (1.0f / 4294967296.0f);
}
template <typename Ctx> float h2(thread Ctx& ctx, int2 i, uint seed) {
return h1(ctx, (as_type<uint>(i.x) * 1597334677u) ^ pcg(ctx, as_type<uint>(i.y) ^ seed));
}
template <typename Ctx> float pnoise(thread Ctx& ctx, float x, float period, uint seed) {
const auto fl = floor(x);
  const auto f = x - fl;
  const auto w = f * f * (3.0f - 2.0f * f);
  const auto pr = max(period, 1.0f);
  const auto ia = fl - pr * floor(fl / pr);
  const auto ib = (ia + 1.0f) - pr * floor((ia + 1.0f) / pr);
  const auto k = seed * 2654435761u;
  const auto a = h1(ctx, wgsl::u32(ia) ^ k);
  const auto b = h1(ctx, wgsl::u32(ib) ^ k);
  return mix(a, b, w) * 2.0f - 1.0f;
}
template <typename Ctx> float2 pnoiseD(thread Ctx& ctx, float x, float period, uint seed) {
const auto fl = floor(x);
  const auto f = x - fl;
  const auto w = f * f * (3.0f - 2.0f * f);
  const auto pr = max(period, 1.0f);
  const auto ia = fl - pr * floor(fl / pr);
  const auto ib = (ia + 1.0f) - pr * floor((ia + 1.0f) / pr);
  const auto k = seed * 2654435761u;
  const auto a = h1(ctx, wgsl::u32(ia) ^ k);
  const auto b = h1(ctx, wgsl::u32(ib) ^ k);
  return float2(mix(a, b, w) * 2.0f - 1.0f, (b - a) * 12.0f * f * (1.0f - f));
}
template <typename Ctx> float pnoise2(thread Ctx& ctx, float2 p, float2 period, uint seed) {
const auto fl = floor(p);
  const auto f = p - fl;
  const auto w = f * f * (3.0f - 2.0f * f);
  const auto pr = max(period, float2(1.0f));
  const auto i0 = fl - pr * floor(fl / pr);
  const auto i1 = (i0 + 1.0f) - pr * floor((i0 + 1.0f) / pr);
  const auto a = h2(ctx, int2(wgsl::i32(i0.x), wgsl::i32(i0.y)), seed);
  const auto b = h2(ctx, int2(wgsl::i32(i1.x), wgsl::i32(i0.y)), seed);
  const auto c = h2(ctx, int2(wgsl::i32(i0.x), wgsl::i32(i1.y)), seed);
  const auto d = h2(ctx, int2(wgsl::i32(i1.x), wgsl::i32(i1.y)), seed);
  return mix(mix(a, b, w.x), mix(c, d, w.x), w.y) * 2.0f - 1.0f;
}
template <typename Ctx> float pfbm(thread Ctx& ctx, float2 p, float2 period, uint seed) {
return(pnoise2(ctx, p, period, seed) + 0.5f * pnoise2(ctx, p * 2.0f, period * 2.0f, seed + 1u) + 0.25f * pnoise2(ctx, p * 4.0f, period * 4.0f, seed + 2u)) / 1.75f;
}
template <typename Ctx> float3 linToSrgb(thread Ctx& ctx, float3 c) {
const auto x = clamp(c, float3(0.0f), float3(1.0f));
  const auto lo = x * 12.92f;
  const auto hi = 1.055f * pow(max(x, float3(1e-7f)), float3(1.0f / 2.4f)) - 0.055f;
  return wgsl::select(hi, lo, x <= float3(0.0031308f));
}
template <typename Ctx> float3 oklabToLinear(thread Ctx& ctx, float3 c) {
const auto l_ = c.x + 0.3963377774f * c.y + 0.2158037573f * c.z;
  const auto m_ = c.x - 0.1055613458f * c.y - 0.0638541728f * c.z;
  const auto s_ = c.x - 0.0894841775f * c.y - 1.2914855480f * c.z;
  const auto l = l_ * l_ * l_;
  const auto m = m_ * m_ * m_;
  const auto s = s_ * s_ * s_;
  return float3(4.0767416621f * l - 3.3077115913f * m + 0.2309699292f * s, - 1.2684380046f * l + 2.6097574011f * m - 0.3413193965f * s, - 0.0041960863f * l - 0.7034186147f * m + 1.7076147010f * s)
  ;
}
template <typename Ctx> float3 oklabToSrgb(thread Ctx& ctx, float3 c) {
return linToSrgb(ctx, oklabToLinear(ctx, c));
}
template <typename Ctx> float3 palLab(thread Ctx& ctx, float x) {
const auto n = max(wgsl::i32(K_palC.x + 0.5f), 1);
  const auto y = fract(x) * float(n);
  const auto fy = floor(y);
  const auto i = wgsl::i32(fy) % n;
  const auto sh = clamp(K_palB.z, 0.0f, 0.98f);
  const auto f = smoothstep(0.5f * sh, 1.0f - 0.5f * sh, y - fy);
  return mix(K_pal[i].xyz, K_pal[(i + 1) % n].xyz, f);
}
template <typename Ctx> float palSeam(thread Ctx& ctx, float x, float fw) {
const auto n = max(wgsl::i32(K_palC.x + 0.5f), 1);
  const auto y = fract(x) * float(n);
  const auto fy = floor(y);
  const auto i = wgsl::i32(fy) % n;
  const auto d = y - fy - 0.5f;
  const auto w = max(K_seam.y, 1e-3f);
  const auto we = sqrt(w * w + 0.25f * fw * fw);
  const auto dc = length(K_pal[i].xyz - K_pal[(i + 1) % n].xyz);
  return(w / we) * exp(- (d * d) / (we * we)) * smoothstep(0.015f, 0.08f, dc);
}
template <typename Ctx> float stripeI(thread Ctx& ctx, float x, float d) {
return floor(x) * d + min(fract(x), d);
}
template <typename Ctx> float stripe(thread Ctx& ctx, float x, float fw, float d) {
return(stripeI(ctx, x + 0.5f * fw, d) - stripeI(ctx, x - 0.5f * fw, d)) / fw;
}
template <typename Ctx> float pulse1(thread Ctx& ctx, float x, float fw, float w) {
const auto a = clamp(x + 0.5f * fw, - 0.5f * w, 0.5f * w);
  const auto b = clamp(x - 0.5f * fw, - 0.5f * w, 0.5f * w);
  return(a - b) / max(fw, 1e-5f);
}
template <typename Ctx> float wellR(thread Ctx& ctx, float D) {
return K_well.y + K_well.x * pow(max(D, 1e-5f), - K_well.z);
}
template <typename Ctx> float wellSquash(thread Ctx& ctx, float D) {
return 1.0f + K_wellLook.w * (1.0f - exp(- D / 0.6f));
}
template <typename Ctx> float fieldX(thread Ctx& ctx, float up, float inside, float rot, uint seedAdd) {
const auto seed = wgsl::u32(K_palB.w + 0.5f) + seedAdd;
  const auto nf = max(floor(K_palC.w + 0.5f), 1.0f);
  const auto nz = pnoise(ctx, up * nf, nf, seed) + 0.5f * pnoise(ctx, up * nf * 2.0f, nf * 2.0f, seed + 11u);
  return up * (*ctx.dyn).palA.x + (*ctx.dyn).palA.y * nz + inside * K_lobe.x + rot;
}
template <typename Ctx> float3 fieldLab(thread Ctx& ctx, float x, float rp, float fws, float mk) {
auto inner = palLab(ctx, x + (*ctx.dyn).palA.w);
  inner = float3(mix(inner.x, 1.0f, K_palC.z), inner.yz * (1.0f - 0.7f * K_palC.z));
  auto lab = mix(inner, palLab(ctx, x), rp);
  if(K_seam.x > 0.0f) {
  const auto sa = clamp(K_seam.x * mix(palSeam(ctx, x + (*ctx.dyn).palA.w, fws), palSeam(ctx, x, fws), rp), 0.0f, 1.0f);
  const auto lifted = float3(min(lab.x + 0.28f * (1.0f - lab.x) + 0.06f, 0.98f), lab.yz * 1.3f);
  const auto metal_ = float3(clamp(K_seamC.x * mix(1.0f, mk, 0.6f), 0.0f, 1.0f), K_seamC.yz * mix(1.0f, mk, 0.3f));
  lab = mix(lab, mix(lifted, metal_, K_seam.w), sa);
  }
  return lab;
}
template <typename Ctx> RingLight ringLight(thread Ctx& ctx, float s, float fs, float N, uint seed, bool quick) {
const auto x = N * s;
  const auto fx = N * fs;
  auto acc = 0.0f;
  auto tot = 0.0f;
  auto amp = 1.0f;
  auto f = 1.0f;
  auto xw = x;
  auto fxw = fx;
  for(auto i = 0u; i < 7u; i++) {
  if(float(i) + 0.5f >= K_stripB.x) {
  break;
  }
  const auto ni = max(rint(N * f), 1.0f);
  if(quick && i > 0u && fs * ni >= 0.5f) {
  acc += amp * 0.5f;
  tot += amp;
  amp *= 0.45f;
  f *= 2.31f;
  continue;
  }
  const auto cells = max(rint(0.314f * ni), 1.0f);
  const auto pn = pnoiseD(ctx, s * cells, cells, seed + 11u * i + 1u);
  const auto ph = K_stripB.w * 10.0f * pn.x;
  const auto v = sin(PI * s * ni + ph);
  const auto lf = fs * (ni + abs(K_stripB.w * 10.0f * pn.y * cells) / PI);
  acc += amp * mix(v * v, 0.5f, smoothstep(0.2f, 0.5f, lf));
  tot += amp;
  xw = wgsl::select(xw, x + ph / PI, i == 0u);
  fxw = wgsl::select(fxw, lf, i == 0u);
  amp *= 0.45f;
  f *= 2.31f;
  }
  auto I = pow(clamp(acc / max(tot, 1e-4f), 0.0f, 1.0f), K_stripB.y);
  if(K_stripD.y > 0.0f) {
  const auto g = 0.25f * x;
  const auto kg = floor(g);
  const auto per = 0.25f * N;
  const auto hk = wgsl::u32(kg - per * floor(kg / per)) * 2654435761u + seed;
  const auto on = step(h1(ctx, hk ^ 0x9E37u), K_stripD.y);
  const auto og = 4.0f * (0.3f + 0.4f * h1(ctx, hk ^ 0x85EBu));
  const auto wg = 0.4f + 1.2f * h1(ctx, hk ^ 0xC2B2u);
  const auto cut = on * pulse1(ctx, 4.0f * (g - kg) - og, fx, wg);
  I = I * mix(1.0f - 0.94f * cut, 1.0f - 0.94f * 0.25f * K_stripD.y, smoothstep(1.0f, 3.0f, fx));
  }
  return RingLight{I, xw, fxw};
}
template <typename Ctx> float3 luminous(thread Ctx& ctx, float3 lin, float shine) {
const auto m = max(max(lin.r, lin.g), max(lin.b, 1e-6f));
  const auto hue = lin / max(m, 1.0f);
  return mix(hue, float3(1.0f), shine * (1.0f - exp(- 1.5f * max(m - 1.0f, 0.0f))));
}
template <typename Ctx> float runWave(thread Ctx& ctx, float k, float up, float g, uint seed) {
const auto h = wgsl::u32(k) * 2246822519u + seed;
  const auto pace = 1.0f + (*ctx.dyn).runB.z * (2.0f * h1(ctx, h ^ 0x7F4Bu) - 1.0f);
  const auto ph = fract(rint((*ctx.dyn).runB.y * pace) * (*ctx.dyn).runB.x) - h1(ctx, h ^ 0xA341u);
  const auto w0 = sin(TAU * (K_runA.y * up - ph));
  const auto w1 = sin(TAU * (K_runA.z * g - ph));
  return mix(w0, w1, K_runA.w);
}
template <typename Ctx> float3 grainLight(thread Ctx& ctx, Grain g, Rings rg, float up, float fs) {
const auto N = max((*ctx.dyn).stripA.x, 4.0f);
  const auto seed = wgsl::u32(K_stripC.w + 0.5f) * 7919u;
  const auto sp = g.x / K_dustA.x;
  const auto L = ringLight(ctx, sp, fs, N, seed, true);
  const auto kc = floor(L.xw - 0.5f);
  const auto ka = kc - N * floor(kc / N);
  const auto ha = wgsl::u32(ka) * 2654435761u + seed;
  const auto npal = max(floor(K_palC.x + 0.5f), 1.0f);
  auto place = sp + (K_stripC.x / npal) * (h1(ctx, ha ^ 0x5BD1u) - 0.5f) + K_dustE.x * (h1(ctx, g.h ^ 0x4E1Bu) - 0.5f) / npal;
  if(K_runA.x > 0.0f) {
  place += K_runA.x * runWave(ctx, ka, up, rg.gabs, seed) / npal;
  }
  const auto pl = palLab(ctx, place);
  const auto lab = float3(mix(pl.x, max(pl.x, 0.8f), K_dustE.y), pl.yz * K_palC.y);
  const auto rel = mix(L.I / pow(0.5f, K_stripB.y), 1.0f, K_dustD.w);
  const auto k = K_stripB.z * mix(K_stripE.w, 1.0f, rel) * (1.0f + 2.0f * K_stripM.w * (h1(ctx, ha ^ 0x68E3u) - 0.5f));
  const auto hs = h1(ctx, g.h ^ 0x7A3Du);
  const auto spark = (1.0f + 12.0f * K_dustD.y * pow(hs, 12.0f)) / (1.0f + 12.0f / 13.0f * K_dustD.y);
  auto tw = 1.0f;
  if(K_dustF.x > 0.0f) {
  const auto n = rint(K_dustF.y * (0.5f + h1(ctx, g.h ^ 0x1F2Eu)));
  const auto wv = 0.5f + 0.5f * sin(TAU * (fract(n * (*ctx.dyn).runB.x) + h1(ctx, g.h ^ 0x6B8Cu)));
  tw = 1.0f + K_dustF.x * (wv * wv * wv / 0.3125f - 1.0f);
  }
  return max(oklabToLinear(ctx, lab), float3(0.0f)) * (K_dustD.x * pow(k, 2.2f) * spark * tw);
}
template <typename Ctx> float3 dust(thread Ctx& ctx, Coords c, float up, Rings rg, float gas) {
const auto Np = K_dustA.x;
  const auto Ma = K_dustA.y;
  const auto Pa = K_dustA.z;
  const auto ray = K_dustB.x > 0.5f;
  const auto rad = (*ctx.dyn).stripA.z;
  const auto arms = (*ctx.dyn).stripA.y;
  const auto seed = wgsl::u32(K_dustC.w + 0.5f) * 2654435761u + 0x2F1Du;
  const auto gx = Np * (rad * rg.dg * c.gp + (arms / TAU) * c.ga);
  const auto ga = wgsl::select((Ma / TAU) * c.ga, (Ma * rg.dg) * c.gp, ray);
  const auto dt = gx.x * ga.y - gx.y * ga.x;
  const auto det = wgsl::select(dt, 1e-12f, abs(dt) < 1e-12f);
  const auto ex = 1.0f / max(length(gx), 1e-6f);
  const auto ea = 1.0f / max(length(ga), 1e-6f);
  const auto cell = rsqrt(abs(det));
  const auto nA = gx * ex;
  const auto nT = float2(- nA.y, nA.x);
  const auto rLim = 0.9f / max(length(gx), length(ga));
  const auto fsp = length(gx) / Np * (*ctx.dyn).flow.z;
  const auto gaA = dot(ga, nA);
  const auto gaT = max(abs(dot(ga, nT)), 1e-6f);
  const auto reach = max(rLim, 0.9f / gaT);
  const auto res = smoothstep(1.6f, 3.0f, min(ex, ea));
  auto parts = float3(0.0f);
  if(false) {
  const auto xp = Np * rg.s;
  const auto ap = Ma * wgsl::select(up, rg.depth, ray);
  const auto k0 = floor(xp);
  auto g1 = Grain{0.0f, 0u, 0.0f, 0.0f};
  auto g2 = Grain{0.0f, 0u, 0.0f, 0.0f};
  for(auto di = - 1; di <= 1; di++) {
  const auto kr = k0 + float(di);
  const auto km = kr - Np * floor(kr / Np);
  const auto hr = wgsl::u32(km) * 2246822519u + seed;
  const auto pace = 1.0f + K_dustE.w * (2.0f * h1(ctx, hr ^ 0x51EDu) - 1.0f);
  const auto ar = ap - h1(ctx, hr ^ 0x0F3Cu) - Pa * fract(rint(K_dustE.z * pace) * (*ctx.dyn).runB.x);
  const auto j0 = floor(ar);
  for(auto dj = - 1; dj <= 1; dj++) {
  const auto jr = j0 + float(dj);
  const auto jm = jr - Pa * floor(jr / Pa);
  const auto h = pcg(ctx, hr ^ (wgsl::u32(jm) * 3266489917u + 0x165667B1u));
  if(h1(ctx, h) >= K_dustB.w) {
  continue;
  }
  const auto cx = kr + 0.5f + K_dustC.x * (h1(ctx, h ^ 0x1B56u) - 0.5f);
  const auto dx = cx - xp;
  const auto da = jr + 0.5f + K_dustC.y * (h1(ctx, h ^ 0x2C9Au) - 0.5f) - ar;
  const auto d = float2(ga.y * dx - gx.y * da, gx.x * da - ga.x * dx) / det;
  if(dot(d, d) >= reach * reach) {
  continue;
  }
  const auto r = 0.5f * K_dustB.y * cell * exp(K_dustB.z * (2.0f * h1(ctx, h ^ 0x3D4Fu) - 1.0f));
  const auto RA = min(1.7320508f * max(r, 1.1f), rLim);
  const auto RT = min(RA * (1.0f + K_dustC.z), sqrt(max(0.81f - (RA * gaA) * (RA * gaA), 0.0f)) / gaT);
  const auto qa = dot(d, nA) / RA;
  const auto qt = dot(d, nT) / RT;
  const auto q2 = qa * qa + qt * qt;
  if(q2 >= 1.0f) {
  continue;
  }
  const auto q = 1.0f - q2;
  const auto re = RA / 1.7320508f;
  const auto w = q * q * q * min(r * r / (re * re), 1.0f);
  const auto gr = Grain{w, h, cx, r};
  if(w > g1.w) {
  g2 = g1;
  g1 = gr;
  } else if(w > g2.w) {
  g2 = gr;
  }
  }
  }
  if(g1.w > 0.0f) {
  parts += g1.w * grainLight(ctx, g1, rg, up, fsp);
  }
  if(g2.w > 0.0f) {
  parts += g2.w * grainLight(ctx, g2, rg, up, fsp);
  }
  }
  auto mean = float3(0.0f);
  if(res < 1.0f) {
  const auto tint = float3(mix(rg.lab.x, max(rg.lab.x, 0.8f), K_dustE.y), rg.lab.yz);
  const auto cl = max(oklabToLinear(ctx, tint), float3(0.0f));
  const auto cmax = max(max(cl.r, cl.g), max(cl.b, 1e-4f));
  const auto c0 = pow(clamp(rg.I, 0.0f, 1.0f), 1.0f / K_stripB.y);
  const auto w0 = 0.55f / (1.0f - pow(0.45f, max(K_stripB.x, 1.0f)));
  auto lit = 0.0f;
  auto shown = 0.0f;
  for(auto j = 0; j < 4; j++) {
  const auto sn = sin(PI * (float(j) + 0.5f) / 8.0f);
  const auto acc = clamp(c0 + w0 * (sn * sn - 0.5f), 0.0f, 1.0f);
  const auto rel = mix(pow(acc, K_stripB.y) / pow(0.5f, K_stripB.y), 1.0f, K_dustD.w);
  const auto P = K_dustD.x * pow(K_stripB.z * mix(K_stripE.w, 1.0f, rel), 2.2f);
  lit += P;
  for(auto i = 0; i < 8; i++) {
  const auto hs = (float(i) + 0.5f) / 8.0f;
  const auto x = P * cmax * (1.0f + 12.0f * K_dustD.y * pow(hs, 12.0f)) / (1.0f + 12.0f / 13.0f * K_dustD.y);
  shown += wgsl::select(0.25f * x, 1.0f - 0.75f * pow(x, - 1.0f / 3.0f), x > 1.0f);
  }
  }
  mean = cl * (K_dustF.z * (lit / 4.0f) * (shown / 32.0f) / max(0.25f * cmax * lit / 4.0f, 1e-6f));
  }
  return gas * rg.lin + mean * (1.0f - res) + ctx.dustAcc.read(uint2(ctx.splashPixel), 0).rgb;
}
template <typename Ctx> float3 paint(thread Ctx& ctx, Coords c, float2 p, float inside) {
const auto mk = wgsl::select(1.0f, 1.0f + K_seam.z * 0.55f * cos(atan2(p.y, p.x + 1e-9f) - K_light.y), K_seam.z > 0.0f);
  const auto up = (c.ang + (*ctx.dyn).palA.z) / TAU;
  const auto rp = smoothstep(K_palB.x - K_palB.y, K_palB.x + K_palB.y, c.pn);
  const auto fws = c.fa / TAU * (*ctx.dyn).palA.x * max(K_palC.x, 1.0f) * (*ctx.dyn).flow.z;
  float3 lab = {};
