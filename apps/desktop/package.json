{
  "name": "@vibefield/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "../../packages/electron-shell/dist/main/index.cjs",
  "scripts": {
    "build:fieldd": "nx run @vibefield/fieldd:build",
    "build:shell": "nx run-many -t build -p @vibefield/fieldd @vibefield/electron-shell",
    "build:renderer": "nx run @vibefield/electron-shell:build:renderer",
    "build:all": "nx run @vibefield/desktop:build",
    "dev": "node ../../tooling/dev-runner/src/cli.mjs",
    "start": "pnpm build:all && electron .",
    "smoke": "pnpm build:shell && electron . --smoke",
    "spike:loro": "pnpm build:shell && VITE_SPIKE=1 pnpm build:renderer && electron . --spike-loro",
    "smoke:godview": "pnpm build:all && electron . --smoke-godview",
    "smoke:canvas": "pnpm build:all && node ../../scripts/bundle-report.mjs --dist ../../packages/electron-shell/dist --assert && electron . --smoke-canvas",
    "icons:generate": "node packaging/generate-icons.mjs",
    "icons:check": "node packaging/generate-icons.mjs --check",
    "//package:stage": "NOT named `stage` — pnpm has a built-in `stage` subcommand that shadows it",
    "package:sea": "node packaging/build-fieldd-sea.mjs",
    "package:stage": "pnpm run icons:check && pnpm build:all && pnpm run package:sea && node ../../scripts/stage-package.mjs",
    "package:verify": "node ../../scripts/stage-package.mjs --verify",
    "package:dir": "pnpm run package:stage && node packaging/run-electron-builder.mjs --dir --config packaging/electron-builder.yml",
    "package:audit": "node ../../scripts/audit-fuses.mjs --app release/mac-arm64/VibeField.app"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@resvg/resvg-js": "2.6.2",
    "@vibefield/electron-shell": "workspace:*",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "postject": "^1.0.0-alpha.6"
  }
}
