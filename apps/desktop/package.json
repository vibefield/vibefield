{
  "name": "@vibefield/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "../../packages/electron-shell/dist/main/index.cjs",
  "scripts": {
    "build:shell": "pnpm --filter @vibefield/electron-shell build",
    "build:renderer": "pnpm --filter @vibefield/electron-shell build:renderer",
    "build": "pnpm build:shell && pnpm build:renderer",
    "dev": "pnpm build:shell && concurrently -k -s first \"pnpm --filter @vibefield/electron-shell dev:renderer\" \"electron . --dev\"",
    "start": "pnpm build && electron .",
    "smoke": "pnpm build:shell && electron . --smoke",
    "spike:loro": "pnpm build:shell && VITE_SPIKE=1 pnpm build:renderer && electron . --spike-loro",
    "smoke:canvas": "pnpm build && node ../../scripts/bundle-report.mjs --dist ../../packages/electron-shell/dist --assert && electron . --smoke-canvas"
  },
  "devDependencies": {
    "@vibefield/electron-shell": "workspace:*",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1"
  }
}
