{
  "name": "@vibefield/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:shell": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "build:renderer": "vite build",
    "build": "pnpm build:shell && pnpm build:renderer",
    "dev": "pnpm build:shell && concurrently -k -s first \"vite\" \"electron . --dev\"",
    "start": "pnpm build && electron .",
    "smoke": "pnpm build:shell && electron . --smoke",
    "spike:loro": "pnpm build && electron . --spike-loro",
    "smoke:canvas": "pnpm build && electron . --smoke-canvas",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p renderer/tsconfig.json"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@vibecook/ice": "*",
    "@vibefield/contracts": "workspace:*",
    "@vibefield/fieldd-client": "workspace:*",
    "@vibefield/plugin-field-tools": "workspace:*",
    "@vibefield/plugin-note": "workspace:*",
    "@vibefield/plugin-runtime": "workspace:*",
    "@vibefield/plugin-widgetlab": "workspace:*",
    "@vibefield/shell-ui": "workspace:*",
    "loro-crdt": "^1.13.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vibefield/fieldd": "workspace:*",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "esbuild": "catalog:",
    "happy-dom": "^20.0.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.5",
    "vitest": "catalog:"
  }
}
