{
  "name": "@vibefield/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "../../packages/electron-shell/dist/main/index.cjs",
  "scripts": {
    "build:fieldd": "pnpm --filter @vibefield/fieldd build",
    "build:shell": "pnpm build:fieldd && pnpm --filter @vibefield/electron-shell build",
    "build:renderer": "pnpm --filter @vibefield/electron-shell build:renderer",
    "build": "pnpm build:shell && pnpm build:renderer",
    "dev": "pnpm build:shell && concurrently -k -s first \"pnpm --filter @vibefield/electron-shell dev:renderer\" \"electron . --dev\"",
    "start": "pnpm build && electron .",
    "smoke": "pnpm build:shell && electron . --smoke",
    "spike:loro": "pnpm build:shell && VITE_SPIKE=1 pnpm build:renderer && electron . --spike-loro",
    "smoke:canvas": "pnpm build && node ../../scripts/bundle-report.mjs --dist ../../packages/electron-shell/dist --assert && electron . --smoke-canvas",
    "//package:stage": "NOT named `stage` — pnpm has a built-in `stage` subcommand that shadows it",
    "package:stage": "pnpm build && node ../../scripts/stage-package.mjs",
    "package:verify": "node ../../scripts/stage-package.mjs --verify",
    "package:dir": "pnpm run package:stage && electron-builder --dir --config packaging/electron-builder.yml",
    "package:audit": "node ../../scripts/audit-fuses.mjs --app release/mac-arm64/VibeField.app"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@vibefield/electron-shell": "workspace:*",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12"
  }
}
