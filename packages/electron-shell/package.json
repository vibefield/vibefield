{
  "name": "@vibefield/electron-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./main": "./dist/main/index.cjs",
    "./preload": "./dist/preload/index.cjs"
  },
  "scripts": {
    "build": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --external:../testing/smoke.cjs --outfile=dist/main/index.cjs && esbuild src/main/bridge-entry.ts --bundle --platform=node --format=esm --outfile=dist/main/bridge-entry.mjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs && esbuild src/testing/smoke.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/testing/smoke.cjs && node scripts/verify-production-main.mjs",
    "build:renderer": "vite build && node scripts/verify-production-renderer.mjs",
    "build:design": "vite build --mode design",
    "dev:design": "node ../../tooling/dev-runner/src/design-bench.mjs",
    "dev:design:web": "vite --mode design --open /design-system.html",
    "dev:renderer": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "verify:production-main": "node scripts/verify-production-main.mjs",
    "verify:production-renderer": "node scripts/verify-production-renderer.mjs"
  },
  "dependencies": {
    "@vibecook/ghosttea-electron": "*",
    "@vibefield/audit": "workspace:*",
    "@vibefield/contracts": "workspace:*",
    "@vibefield/field-app": "workspace:*",
    "@vibefield/fieldd-supervisor": "workspace:*",
    "@vibefield/logging": "workspace:*",
    "@vibefield/users": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vibecook/ghosttea-client": "*",
    "@vibefield/fieldd": "workspace:*",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "esbuild": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.5",
    "vitest": "catalog:"
  }
}
