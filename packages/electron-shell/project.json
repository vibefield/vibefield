{
  "name": "@vibefield/electron-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/dist/main",
        "{projectRoot}/dist/preload",
        "{projectRoot}/dist/testing",
        "{workspaceRoot}/apps/desktop/build/native/macos/desktop-haptics.node",
        "{workspaceRoot}/apps/desktop/build/native/macos/desktop-sound-player.node"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "env": "NODE_ENV"
        },
        {
          "env": "VITE_SPIKE"
        },
        "{workspaceRoot}/apps/desktop/native/macos/haptics/**/*",
        "{workspaceRoot}/apps/desktop/packaging/build-haptics.mjs",
        "{workspaceRoot}/apps/desktop/native/macos/sound/**/*",
        "{workspaceRoot}/apps/desktop/packaging/build-sound-player.mjs",
        {
          "runtime": "node -p \"process.platform + process.arch\""
        }
      ]
    },
    "build:renderer": {
      "outputs": ["{projectRoot}/dist/renderer"]
    },
    "test": {
      "inputs": ["default", "^default", "{workspaceRoot}/apps/desktop/packaging/*.mjs"]
    }
  }
}
