{
  "name": "@vibefield/field-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "sharedGlobals",
        "siblings"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./appearance": "./src/appearance/index.ts",
    "./design-system": "./src/design-system/mount.tsx",
    "./design-system/studio-controller": "./src/design-system/studio-controller.ts",
    "./host-kit": "./src/host-kit.ts",
    "./logging": "./src/logging.ts",
    "./terminal-perf-lab": "./src/perf/terminal-perf-lab.ts",
    "./godview-perf-lab": "./src/godview/monitor/perf/lab-bridge.ts",
    "./spike": "./src/spike/spike-loro.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "perf:godview:corpora": "vitest run --config vitest.perf.config.ts perf/corpora.generate.perf.ts",
    "perf:godview:model": "vitest run --config vitest.perf.config.ts perf/model-streams.generate.perf.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.6.1",
    "@rosetta/protocol": "*",
    "@rosetta/room": "*",
    "@vibecook/ghosttea-protocol": "*",
    "@vibecook/ghosttea-react": "*",
    "@vibecook/ice": "*",
    "@vibecook/puppeteer-core": "*",
    "@vibecook/puppeteer-monitor": "*",
    "@vibecook/puppeteer-view-sdk": "*",
    "@vibecook/puppeteer-views": "*",
    "@vibefield/contracts": "workspace:*",
    "@vibefield/design-kit": "workspace:*",
    "@vibefield/fieldd-client": "workspace:*",
    "@vibefield/live-surfaces": "workspace:*",
    "@vibefield/plugin-browser": "workspace:*",
    "@vibefield/plugin-field-tools": "workspace:*",
    "@vibefield/plugin-note": "workspace:*",
    "@vibefield/plugin-runtime": "workspace:*",
    "@vibefield/plugin-sdk": "workspace:*",
    "@vibefield/plugin-widgetlab": "workspace:*",
    "loro-crdt": "^1.13.6",
    "matter-js": "0.19.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "^0.185.0",
    "@vibecook/mille": "*",
    "@vibecook/mille-ui": "*"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.185.0",
    "@vibefield/fieldd": "workspace:*",
    "happy-dom": "^20.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
