{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // SD-2: @vibefield/sound (a zero-dependency root, SD-1) writes `.ts` specifiers so plain node runs it; a
    // program that typechecks its source must accept them (this program emits nothing)
    "allowImportingTsExtensions": true,
    // an app, not a library: no declaration emit — also silences TS2742
    // portability errors for types inferred from ice's transitive strata dep
    "declaration": false
  },
  "include": ["src", "test", "perf"]
}
