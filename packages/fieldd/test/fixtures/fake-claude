#!/bin/sh
# AR-2 test fixture: an executable the claude adapter classifies as Claude Code
# from its version banner (the vendor's `--version` grammar, `x.y.z (Claude
# Code)`), placed on a PRIVATE search path so the install inventory finds it
# and nothing of the developer's. `update` is the vendor's own updater as the
# adapter's recipe invokes it for a standalone binary: it exits 0 and changes
# nothing, so a re-inspection reads the same version — "already-current".
# AR-3: `auth login` is the interactive login the persona login pane runs (it
# returns at once, so the pane ends and the persona is verified); `auth status
# --json` is the identity surface the adapter reads afterwards (the documented
# `loggedIn` boolean and the fields beside it, as probed on Claude Code 2.1).
# AR-S2: `auth logout` signs a folder out, and `auth status` reads signed out
# afterwards, as the vendor's does — the adapter confirms a sign-out that way. A
# bound root (CLAUDE_CONFIG_DIR) keeps the mark inside itself; the agent's own
# folder keeps it under FAKE_CLAUDE_STATE_DIR when a test names one, and nowhere
# otherwise: never in the developer's real ~/.claude.
# PJ-6: `--print --input-format stream-json …` is the model picker read
# (puppeteer's Claude model service): one `initialize` control request on
# stdin, answered with the vendor's own `models` rows — two of them, the first
# with its effort levels — under the request's own id, as Claude Code 2.1 does.
# Item 62: a row that must see a read IN FLIGHT holds it. While
# FAKE_CLAUDE_STATE_DIR/status-hold exists, `auth status` waits before it
# answers; the adapter's own 10 s timeout is the ceiling. No file, no wait.
mark() {
  if [ -n "$CLAUDE_CONFIG_DIR" ]; then echo "$CLAUDE_CONFIG_DIR/.fake-signed-out"
  elif [ -n "$FAKE_CLAUDE_STATE_DIR" ]; then echo "$FAKE_CLAUDE_STATE_DIR/native-signed-out"
  fi
}
case "$1" in
  --version) echo "2.1.0 (Claude Code)" ;;
  update) echo "fake claude: nothing to update" ;;
  --print)
    IFS= read -r line
    case "$line" in
      *'"initialize"'*)
        id=$(printf '%s\n' "$line" | sed -n 's/.*"request_id":\([0-9][0-9]*\).*/\1/p')
        printf '{"type":"control_response","response":{"subtype":"success","request_id":%s,"response":{"models":[{"value":"fake-model-a","displayName":"Fake Model A","description":"The fake picker'"'"'s first model","supportedEffortLevels":["low","high"],"supportsEffort":true},{"value":"fake-model-b","displayName":"Fake Model B","supportsEffort":false}]}}}\n' "$id"
        ;;
      *) : ;;
    esac
    ;;
  auth)
    case "$2" in
      login) m=$(mark); [ -n "$m" ] && rm -f "$m"; echo "fake claude: logged in" ;;
      logout) m=$(mark); [ -n "$m" ] && : > "$m"; echo "fake claude: logged out" ;;
      status)
        if [ -n "$FAKE_CLAUDE_STATE_DIR" ]; then
          while [ -f "$FAKE_CLAUDE_STATE_DIR/status-hold" ]; do sleep 0.05; done
        fi
        m=$(mark)
        if [ -n "$m" ] && [ -f "$m" ]; then echo '{"loggedIn":false}'
        else echo '{"loggedIn":true,"authMethod":"claude.ai","apiProvider":"firstParty","email":"persona@example.test","orgName":"Example Org","subscriptionType":"max"}'
        fi
        ;;
      *) : ;;
    esac
    ;;
  *) : ;;
esac
exit 0
