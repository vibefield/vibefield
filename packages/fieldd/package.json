{
  "name": "@vibefield/fieldd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "sharedGlobals",
        "siblings"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/mock-mgmt.ts"
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=cjs --define:import.meta.url=undefined --outfile=dist/bin.cjs --external:bufferutil --external:utf-8-validate && esbuild src/service-worker-harness.mjs --bundle --platform=node --format=esm --outfile=dist/service-harness.mjs --external:bufferutil --external:loro-crdt --external:utf-8-validate && esbuild @vibecook/puppeteer-runtime/spawn-through/shim --bundle --platform=node --format=cjs --target=node22 --outfile=dist/agent-shim.cjs && node scripts/stage-runtime-assets.mjs && node scripts/files-host-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rosetta/protocol": "*",
    "@vibecook/ghosttea-client": "*",
    "@vibecook/mille": "*",
    "@vibecook/puppeteer-builtin-providers": "*",
    "@vibecook/puppeteer-core": "*",
    "@vibecook/puppeteer-monitor": "*",
    "@vibecook/puppeteer-record": "*",
    "@vibecook/puppeteer-runtime": "*",
    "@vibecook/puppeteer-view-sdk": "*",
    "@vibefield/audit": "workspace:*",
    "@vibefield/contracts": "workspace:*",
    "@vibefield/fieldd-client": "workspace:*",
    "@vibefield/logging": "workspace:*",
    "@vibefield/plugin-build": "workspace:*",
    "@vibefield/plugin-runtime": "workspace:*",
    "@vibefield/plugin-sdk": "workspace:*",
    "@vibefield/users": "workspace:*",
    "ajv": "^8.17.1",
    "loro-crdt": "^1.13.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "^8.5.0",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
