{
  "manifestVersion": 1,
  "id": "com.example.metrics",
  "version": "1.2.0",
  "title": "Metrics",
  "engines": {
    "app": "^0.1.0",
    "contracts": "^0.1.0",
    "platforms": ["darwin", "linux"]
  },
  "entries": {
    "renderer": "./dist/renderer.js",
    "service": "./dist/service.js"
  },
  "host": "worker",
  "activation": ["onService:x.com.example.metrics.snapshot", "onWidget:com.example.metrics.chart"],
  "capabilities": [
    "services.provide",
    "storage.self",
    "canvas.read",
    "canvas.write",
    "doc.write",
    "mcp.contribute",
    "x.com.example.metrics.read"
  ],
  "contributes": {
    "capabilities": [
      {
        "id": "x.com.example.metrics.read",
        "title": "Read local metrics",
        "description": "Returns the metrics collected by this plugin",
        "risk": "read"
      }
    ],
    "widgets": [
      {
        "type": "com.example.metrics.chart",
        "title": "Metrics chart",
        "schemaVersion": 1,
        "surface": "dom",
        "sizeMode": "fixed",
        "defaultSize": {
          "w": 329,
          "h": 155
        },
        "ports": [
          {
            "id": "out",
            "side": "e",
            "accepts": ["signal"]
          }
        ],
        "props": {
          "source": {
            "kind": "string",
            "maxLength": 200
          }
        },
        "groups": {
          "source": ["source"]
        },
        "behaviors": [
          {
            "id": "com.example.metrics:ticker"
          }
        ]
      }
    ],
    "behaviors": [
      {
        "id": "com.example.metrics:ticker",
        "reason": "advance the live sparkline between service snapshots",
        "definition": {
          "store": "runtime",
          "derived": false,
          "deriveDuringGesture": false,
          "version": 1,
          "phase": "simulate",
          "budgetMs": 1,
          "tickWhile": "all",
          "schema": [],
          "reads": [],
          "writes": [],
          "migrationFrom": [],
          "hooks": ["tick"]
        }
      }
    ],
    "settings": {
      "properties": {
        "sampleHz": {
          "title": "Sample rate",
          "scope": "user",
          "schema": {
            "type": "number",
            "minimum": 1,
            "maximum": 60,
            "default": 10
          }
        }
      }
    },
    "services": [
      {
        "namespace": "x.com.example.metrics",
        "methods": [
          {
            "name": "snapshot",
            "kind": "query",
            "requiredCapability": "x.com.example.metrics.read",
            "idempotent": true,
            "locality": "local",
            "input": {
              "type": "object",
              "additionalProperties": false
            },
            "output": {
              "type": "object",
              "required": ["sampledAt", "values"],
              "properties": {
                "sampledAt": {
                  "type": "number"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 1000
                }
              },
              "additionalProperties": false
            }
          }
        ]
      }
    ],
    "mcp": {
      "tools": [
        {
          "name": "metrics-snapshot",
          "title": "Metrics snapshot",
          "description": "Read the current metrics sample",
          "method": "x.com.example.metrics.snapshot"
        }
      ]
    }
  }
}
