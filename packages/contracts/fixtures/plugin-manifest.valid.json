{
  "manifestVersion": 1,
  "id": "com.example.notes",
  "version": "0.1.0",
  "title": "Example Notes",
  "description": "A renderer-only note kind — the minimal real plugin: one object, one export",
  "engines": {
    "app": "^0.1.0",
    "contracts": "^0.1.0"
  },
  "entries": {
    "renderer": "./dist/renderer.js"
  },
  "activation": ["onWidget:com.example.notes"],
  "capabilities": ["doc.write"],
  "contributes": {
    "objects": [
      {
        "type": "com.example.notes",
        "title": "Note",
        "description": "A sticky note",
        "schemaVersion": 1,
        "size": {
          "w": 260,
          "h": 180
        },
        "minSize": {
          "w": 120,
          "h": 90
        },
        "interaction": {
          "selectable": true,
          "movable": true,
          "resizable": true,
          "snap": "both"
        },
        "provides": ["com.example.notes", "desk.object"],
        "props": {
          "text": {
            "kind": "string",
            "default": "",
            "maxLength": 4000
          },
          "color": {
            "kind": "enum",
            "options": ["yellow", "blue", "pink"],
            "default": "yellow"
          }
        },
        "groups": {
          "text": ["text"],
          "color": ["color"]
        },
        "binding": {
          "kind": "note"
        }
      }
    ]
  }
}
