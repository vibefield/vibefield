+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub(crate) struct PeerPolicy {
+    /// None: any same-uid peer. Some: only these pids (empty admits no one).
+    pub allowed_pids: Option<Vec<i32>>,
+}
+
+pub(crate) fn peer_policy(
+    pids_raw: Option<&str>,
+    uid_check_raw: Option<&str>,
+) -> Option<PeerPolicy> {
+    let allowed_pids = parse_peer_pids(pids_raw);
+    (allowed_pids.is_some() || env_flag_is_set(uid_check_raw))
+        .then_some(PeerPolicy { allowed_pids })
+}
+
+pub(crate) fn peer_policy_from_env() -> Option<PeerPolicy> {
+    peer_policy(
+        env::var("AGENT_BROWSER_PEER_PIDS").ok().as_deref(),
+        env::var("AGENT_BROWSER_PEER_UID_CHECK").ok().as_deref(),
+    )
+}
