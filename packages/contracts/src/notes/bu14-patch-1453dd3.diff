+/// BU-14 patch 3: true when AGENT_BROWSER_HIDE_CDP_URL is on. `get cdp-url`
+/// then never launches a session to answer, and refuses for a session
+/// launched through a provider or attached by a URL that carries a credential.
+pub(crate) fn hide_cdp_url() -> bool {
+    super::daemon::env_flag_is_set(env::var("AGENT_BROWSER_HIDE_CDP_URL").ok().as_deref())
+}
+
+/// BU-14 patch 3: a CDP URL with a query string or userinfo can carry a
+/// credential (a provider's `?token=…`, `user:pass@`), whatever attached it.
+/// A URL that does not parse is treated as carrying one.
+pub(crate) fn cdp_url_may_carry_credential(raw: &str) -> bool {
+    url::Url::parse(raw).map_or(true, |u| {
+        u.query().is_some() || !u.username().is_empty() || u.password().is_some()
+    })
+}
+
+/// BU-14 patch 3: under the switch, why this session's CDP URL is withheld.
+fn cdp_url_withheld(state: &DaemonState) -> Option<&'static str> {
+    if !hide_cdp_url() {
+        return None;
+    }
+    if state.active_provider_connection || state.active_provider_session.is_some() {
+        return Some("The CDP URL is withheld for a provider session (AGENT_BROWSER_HIDE_CDP_URL)");
+    }
+    if state
+        .browser
+        .as_ref()
+        .is_some_and(|mgr| cdp_url_may_carry_credential(mgr.get_cdp_url()))
+    {
+        return Some(
+            "The CDP URL is withheld: it carries a query string or userinfo \
+             (AGENT_BROWSER_HIDE_CDP_URL)",
+        );
+    }
+    None
+}
+
 fn handle_cdp_url(state: &DaemonState) -> Result<Value, String> {
+    if let Some(reason) = cdp_url_withheld(state) {
+        return Err(reason.to_string());
+    }
     let mgr = state.browser.as_ref().ok_or("Browser not launched")?;
     Ok(json!({ "cdpUrl": mgr.get_cdp_url() }))
 }
 
