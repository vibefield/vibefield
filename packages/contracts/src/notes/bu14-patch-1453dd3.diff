+/// BU-14 patch 1: why `dashboard start` refuses under the stream opt-out.
+const DASHBOARD_NO_STREAM_ERROR: &str = "The dashboard is disabled: AGENT_BROWSER_NO_STREAM is \
+     set, so agent-browser binds no TCP listener. Unset it to use the dashboard.";
+
+/// BU-14: whether the CLI may send its pre-launches for this command. False
+/// for `cdp_url`, or a batch whose every command is `get cdp-url` (given as
+/// arguments or on stdin), while AGENT_BROWSER_HIDE_CDP_URL is on, so answering
+/// it never launches a session (patch 3); and for `inspect` while
+/// AGENT_BROWSER_NO_STREAM is on, because the daemon refuses it (patch 1).
+/// A mixed batch still launches; its `get cdp-url` step is refused by the
+/// daemon where the URL is withheld.
+fn prelaunch_allowed(command: &serde_json::Value, hide_cdp_url: bool, no_stream: bool) -> bool {
+    match command.get("action").and_then(|a| a.as_str()) {
+        Some("cdp_url") => !hide_cdp_url,
+        Some("inspect") => !no_stream,
+        Some("batch") => !(hide_cdp_url && batch_is_only_get_cdp_url(command)),
+        _ => true,
+    }
+}
+
+/// BU-14 patch 3: true when a batch holds at least one command and every one
+/// is `get cdp-url`, read the way `command_is_browserless` reads a batch.
+fn batch_is_only_get_cdp_url(cmd: &serde_json::Value) -> bool {
+    let is_get_cdp_url =
+        |words: &[String]| words.len() >= 2 && words[0] == "get" && words[1] == "cdp-url";
+    let batch: Vec<Vec<String>> = if let Some(argv) = cmd.get("argv").and_then(|v| v.as_array()) {
+        argv.iter()
+            .map(|c| {
+                c.as_array()
+                    .map(|ws| {
+                        ws.iter()
+                            .filter_map(|w| w.as_str().map(str::to_string))
+                            .collect()
+                    })
+                    .unwrap_or_default()
+            })
+            .collect()
+    } else if let Some(commands) = cmd.get("commands").and_then(|v| v.as_array()) {
+        commands
+            .iter()
+            .map(|c| {
+                c.as_str()
+                    .map(commands::shell_words_split)
+                    .unwrap_or_default()
+            })
+            .collect()
+    } else {
+        return false;
+    };
+    !batch.is_empty() && batch.iter().all(|words| is_get_cdp_url(words))
+}
