+/// BU-14 patch 1 (after upstream PR #1591): true when AGENT_BROWSER_NO_STREAM
+/// is on. The daemon then binds no stream server (no TCP listener, so no
+/// WebSocket input and no `/api/command` relay), writes no `.stream` file, and
+/// `stream enable`, `inspect` and the CLI's `dashboard start` refuse. Read from
+/// the daemon's own environment, inherited from the CLI that spawned it, so it
+/// is stable for its lifetime.
+pub(crate) fn stream_opt_out() -> bool {
+    env_flag_is_set(env::var("AGENT_BROWSER_NO_STREAM").ok().as_deref())
+}
+
+/// A BU-14 switch is on for any value except unset, empty, `0`, `false` or
+/// `no` (case-insensitive, trimmed): upstream's own `env_var_is_truthy`
+/// convention (flags.rs, providers.rs), so a security switch never stays off
+/// on a spelling such as `TRUE` or `yes`.
+pub(crate) fn env_flag_is_set(raw: Option<&str>) -> bool {
+    raw.map(|v| v.trim().to_ascii_lowercase())
+        .is_some_and(|v| !matches!(v.as_str(), "" | "0" | "false" | "no"))
+}
