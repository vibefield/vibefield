+/// BU-14 patch 2: parse AGENT_BROWSER_PEER_PIDS (a comma list of pids). Unset
+/// means no pid allowlist. Entries that do not parse are dropped, so a present
+/// value that names no valid pid, blank included, admits no peer (fail closed).
+pub(crate) fn parse_peer_pids(raw: Option<&str>) -> Option<Vec<i32>> {
+    Some(
+        raw?.split(',')
+            .filter_map(|p| p.trim().parse::<i32>().ok())
+            .filter(|p| *p > 0)
+            .collect(),
+    )
+}
+
+/// BU-14 patch 2: why a peer is refused, or None to admit it. A peer of any
+/// other uid is refused; with an allowlist, so is a peer whose pid is not on it
+/// (or whose pid could not be read).
 #[cfg(unix)]
+pub(crate) fn peer_refusal(
+    peer_uid: u32,
+    peer_pid: Option<i32>,
+    own_uid: u32,
+    allowed_pids: Option<&[i32]>,
+) -> Option<String> {
+    if peer_uid != own_uid {
+        return Some(format!(
+            "uid {} is not the daemon's uid {} (pid {:?})",
+            peer_uid, own_uid, peer_pid
+        ));
+    }
+    match (allowed_pids, peer_pid) {
+        (Some(allowed), Some(pid)) if !allowed.contains(&pid) => {
+            Some(format!("pid {} is not in AGENT_BROWSER_PEER_PIDS", pid))
+        }
+        (Some(_), None) => Some("peer pid unavailable under AGENT_BROWSER_PEER_PIDS".to_string()),
+        _ => None,
+    }
+}
