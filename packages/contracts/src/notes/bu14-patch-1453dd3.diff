+/// BU-14 patch 2: check an accepted socket's peer. The uid comes from
+/// getpeereid (macOS) or SO_PEERCRED (Linux) through tokio's `peer_cred`.
+#[cfg(unix)]
+pub(crate) fn check_unix_peer(
+    stream: &tokio::net::UnixStream,
+    allowed_pids: Option<&[i32]>,
+) -> Result<(), String> {
+    let cred = stream
+        .peer_cred()
+        .map_err(|e| format!("peer credentials unreadable: {}", e))?;
+    // SAFETY: geteuid has no preconditions.
+    let own_uid = unsafe { libc::geteuid() };
+    match peer_refusal(cred.uid(), unix_peer_pid(stream), own_uid, allowed_pids) {
+        Some(reason) => Err(reason),
+        None => Ok(()),
+    }
+}
