{
  "name": "@vibefield/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent-catalog": "./src/agent-catalog.ts",
    "./agent-index": "./src/agent-index.ts",
    "./compose-tools": "./gen/compose-tools.ts",
    "./diagnostics": "./src/diagnostics.ts",
    "./logging": "./src/logging.ts",
    "./phone-code": "./src/phone-code.ts",
    "./registries": "./src/registries.ts",
    "./setup": "./src/setup.ts",
    "./user-face": "./src/user-face.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:schema": "tsx scripts/gen-jsonschema.ts && tsx scripts/gen-catalog.ts && tsx scripts/gen-compose-tools.ts",
    "gen:rust": "pnpm gen:schema && tsx scripts/gen-registries-rs.ts && cargo typify gen/jsonschema/bundle.json -o ../field-native/src/contracts.rs"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod-to-json-schema": "^3.24.0"
  }
}
