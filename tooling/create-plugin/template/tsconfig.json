{
  // SELF-CONTAINED on purpose: a plugin may live outside the repository that
  // owns tsconfig.base.json, and a scaffold whose `extends` path depends on how
  // deep it was placed is a scaffold that breaks the moment someone moves it.
  // These options ARE tsconfig.base.json's, plus what an object kind adds — the
  // DOM libs and the WebGPU globals its pass names (`GPUDevice`, `GPUBlendState`)
  // — and create-plugin's own test (in the kit, not in this scaffold) fails if the two ever drift apart.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "test", "playground", "scripts", "vitest.config.ts"]
}
