        "{workspaceRoot}/apps/desktop/packaging/codesign-entitlements.mjs",
        "{workspaceRoot}/apps/desktop/packaging/entitlements.mac.plist",
        "{workspaceRoot}/apps/desktop/packaging/entitlements.mac.inherit.plist",
        "{workspaceRoot}/apps/desktop/packaging/entitlements.mac.native.plist",
        "{workspaceRoot}/apps/desktop/packaging/sign-mac.mjs",
        "{workspaceRoot}/apps/desktop/packaging/electron-builder.release.yml",
        "{workspaceRoot}/scripts/siblings.mjs",
        "{workspaceRoot}/scripts/electron-binary.mjs",
        "{workspaceRoot}/scripts/git-hooks/pre-commit",
        "{workspaceRoot}/siblings.lock.json",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/Cargo.toml"
