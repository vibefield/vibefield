{
  "name": "@vibefield/dev-runner",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "dev": {
      "continuous": true,
      "cache": false
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/packages/fieldd/package.json",
        "{workspaceRoot}/packages/fieldd/scripts/**/*",
        "{workspaceRoot}/packages/fieldd/src/workspace/**/*",
        "{workspaceRoot}/packages/contracts/src/**/*",
        "{workspaceRoot}/scripts/stage-package.mjs",
        "{workspaceRoot}/scripts/third-party-notices.mjs",
        "{workspaceRoot}/apps/ios/App/Resources/acknowledgements.json",
        "{workspaceRoot}/apps/ios/VibeFieldKit/Package.resolved",
        "{workspaceRoot}/apps/desktop/packaging/notices/go-modules.json",
        "{workspaceRoot}/apps/desktop/packaging/electron-builder.yml",
        "{workspaceRoot}/apps/desktop/package.json",
        "{workspaceRoot}/apps/desktop/packaging/bundled-plugins.mjs",
        "{workspaceRoot}/apps/desktop/packaging/stage-bundled-fixture.mjs",
        "{workspaceRoot}/apps/desktop/packaging/verify-plugins-package.mjs",
        "{workspaceRoot}/packages/electron-shell/src/testing/smoke-bundled.ts",
        "{workspaceRoot}/scripts/gate-landing.mjs",
        "{workspaceRoot}/scripts/trust-keygen.mjs",
