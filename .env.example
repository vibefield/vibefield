# VibeField dev environment variables.
#
# Nothing auto-loads this file — export in the shell that launches the daemon/app
# (or use direnv; `.env` is gitignored, `.env.example` is the committed template).
#
# FIELD_* / FIELDD_* prefixes are reserved to VibeField (contracts ENV_PREFIXES)
# and are stripped from agent PTY environments (EL7) — never hide agent-visible
# config behind other names to dodge the strip list.

# field-native data dir
# (default: ~/Library/Application Support/VibeField on macOS, ~/.local/share/VibeField elsewhere)
#FIELD_NATIVE_DATA_DIR=

# MeshGateway master switch — off unless "1"/"true" (C1: unit reports "disabled" honestly)
#FIELD_NATIVE_MESH=1

# The terminal floor's doors are published on the tailnet (TM-1). A separate
# switch from the gateway above: that one asks whether this device has a tailnet
# identity, this one whether its terminals are reachable over it. It selects no
# serve shape — cells serve either way — and it is a REQUEST: the answer the
# floor gives on its hello (`terminalMesh`) is true only once the gateway's node
# is actually up. Until 2026-09-14 this flag kept the pre-cell in-process floor,
# and a desktop with it set could not open a pane at all; that is gone.
#FIELD_NATIVE_TERMINAL_MESH=1

# Mirror-write v1 — the one capability a remote viewer must present to gain
# WRITE on a mirrored session; without it every peer is view-only. Dead weight
# since TM-1 and kept only until TM-3: nothing on this floor compares it any
# more (the TSP1 adapter that did retired with the in-process serve), but the
# phone still asks for it over `terminal.mirrorWriteGrant` until its attach
# moves onto T1, where an expiring per-client grant carries the write right
# instead. SETTING THIS IS OPTIONAL since MF-2a: a floor whose terminal mesh is
# on mints its own on first boot
# (`<data dir>/native/terminal-mirror-write.key`, 0600) and hands it
# to a linked device over the door (`terminal.mirrorWriteGrant`) — nobody types
# it into a phone. Exporting one still wins, and then nothing is written.
# Rotation: delete the file (or change this value) and bounce the daemon pair —
# either revokes every device at once, which is v1's honest shape.
#FIELD_NATIVE_TERMINAL_MIRROR_WRITE=

# explicit tsnet sidecar binary path; falls back to truffle's search order
# (TRUFFLE_SIDECAR_PATH is the upstream fallback name)
#FIELD_NATIVE_SIDECAR_PATH=
#TRUFFLE_SIDECAR_PATH=

# Logging root override — development/tests only. Production resolves the
# platform root and does not honor an arbitrary ambient override (LOG-43).
#FIELD_LOG_DIR=
# Standalone fieldd requires this explicit trust decision before honoring the
# override. Electron dev/smoke launchers set it themselves.
#FIELDD_ALLOW_LOG_DIR_OVERRIDE=1
# Direct field-native development requires its own explicit trust decision.
# Normal launches receive the already-resolved root from fieldd.
#FIELD_NATIVE_ALLOW_LOG_DIR_OVERRIDE=1

# Development/test-only tracing target filter (e.g. "info" or
# "field_native=debug,truffle_core=info"). Production ignores it unless the
# explicit allow flag is present.
#FIELD_NATIVE_LOG_FILTER=
#FIELD_NATIVE_ALLOW_LOG_FILTER=1

# fieldd standalone (bin.cjs) — the shell passes these itself in normal runs
#FIELDD_DATA_DIR=
#FIELDD_CONTROL_PORT=9410
# B3: the :9411 doc lane (binary data plane; 0 = ephemeral for tests)
#FIELDD_DATA_PORT=9411
# AR-0 — the rosettad binary fieldd supervises for the agent index (built from
# the rosetta sibling: `pnpm siblings:build`; `pnpm siblings` prints the path).
# The dev runner sets it when the binary exists; unset or empty ⇒ fieldd reports
# the agent index UNAVAILABLE {state:"unconfigured"} honestly and spawns nothing.
#FIELDD_ROSETTAD_BIN=

# REQUIRED for real-network tests & benches. Leave unset to skip them.
# A Tailscale auth key. Test nodes register EPHEMERAL, so they disappear from
# the tailnet ~30-60 min after the process dies rather than piling up as dead
# devices. Real .env values are gitignored; this file must stay empty.
#   cargo test -p field-native --test quic_lane_probe -- --ignored --nocapture
TRUFFLE_TEST_AUTHKEY=
